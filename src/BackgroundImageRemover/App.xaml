<Application x:Class="BackgroundImageRemover.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BackgroundImageRemover"
             xmlns:conv="clr-namespace:BackgroundImageRemover.Converters">
    <Application.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <conv:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    </Application.Resources>
</Application>
