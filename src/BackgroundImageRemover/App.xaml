<Application x:Class="BackgroundImageRemover.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BackgroundImageRemover"
             xmlns:conv="clr-namespace:BackgroundImageRemover.Converters"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Implicit control styles shared by both themes (colors resolved with DynamicResource). -->
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
                <!-- Strategy icon resources -->
                <ResourceDictionary Source="Themes/StrategyIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <conv:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <conv:ActiveStrategyToBoolConverter x:Key="ActiveStrategyToBoolConverter" />
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <conv:ResourceKeyToGeometryConverter x:Key="ResourceKeyToGeometryConverter" />
        <conv:ToolDefinitionCheckedConverter x:Key="ToolDefinitionCheckedConverter" />

        <!-- Shared tool-session layout (status bar + right settings panel + preview area). -->
        <Style TargetType="{x:Type controls:ToolSessionPanel}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:ToolSessionPanel}">
                        <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
                            <StatusBar DockPanel.Dock="Bottom"
                                       Background="{DynamicResource Theme.BarBackground}"
                                       TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}"
                                       Visibility="{Binding ShowStatusBar, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StatusBarItem>
                                    <TextBlock Text="{Binding StatusMessage}" />
                                </StatusBarItem>
                                <ContentControl Content="{Binding StatusBarContent, RelativeSource={RelativeSource TemplatedParent}}" />
                            </StatusBar>
                            <Border DockPanel.Dock="Right"
                                    Width="{Binding PanelWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Padding="14"
                                    BorderBrush="{DynamicResource Theme.BorderBrush}"
                                    BorderThickness="1,0,0,0"
                                    Background="{DynamicResource Theme.PanelBackground}"
                                    TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="15" FontWeight="Bold" Margin="0,0,0,8"
                                                   Foreground="{DynamicResource Theme.ForegroundBrush}" />
                                        <TextBlock Text="{Binding Description, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Margin="0,0,0,12"
                                                   Foreground="{DynamicResource Theme.MutedForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <ContentPresenter Content="{Binding Panel, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Button Content="{Binding ResetLabel, RelativeSource={RelativeSource TemplatedParent}}"
                                                Command="{Binding ResetCommand}"
                                                Height="30" Margin="0,8,0,0"
                                                Background="{DynamicResource Theme.PanelHeaderBackground}"
                                                Foreground="{DynamicResource Theme.ForegroundBrush}"
                                                BorderBrush="{DynamicResource Theme.BorderBrush}"
                                                BorderThickness="1"
                                                Visibility="{Binding ShowReset, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                            <ContentPresenter Content="{Binding Preview, RelativeSource={RelativeSource TemplatedParent}}" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
