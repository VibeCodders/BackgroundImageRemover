<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core surfaces -->
    <SolidColorBrush x:Key="Theme.WindowBackground" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="Theme.BarBackground" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="Theme.PanelBackground" Color="#FF252525" />
    <SolidColorBrush x:Key="Theme.PanelHeaderBackground" Color="#FF303030" />
    <SolidColorBrush x:Key="Theme.BorderBrush" Color="#FF3F3F3F" />
    <SolidColorBrush x:Key="Theme.ForegroundBrush" Color="#FFE8E8E8" />
    <SolidColorBrush x:Key="Theme.MutedForegroundBrush" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="Theme.SubtleForegroundBrush" Color="#FF7A7A7A" />
    <SolidColorBrush x:Key="Theme.DisabledForegroundBrush" Color="#FF6E6E6E" />

    <!-- Accent / primary action -->
    <SolidColorBrush x:Key="Theme.AccentBackground" Color="#FF0078D7" />
    <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#FF1A86E5" />
    <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#FF0060B0" />
    <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFFFF" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="Theme.ButtonBackground" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Theme.ButtonHoverBackground" Color="#FF434343" />
    <SolidColorBrush x:Key="Theme.ButtonPressedBackground" Color="#FF4D4D4D" />
    <SolidColorBrush x:Key="Theme.ButtonBorderBrush" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="Theme.ButtonHoverBorderBrush" Color="#FF4DA3FF" />
    <!-- Translucent overlays on top of the button background, so hover/pressed feedback is
         visible on both plain and accent (e.g. blue "Apply") buttons without repainting them. -->
    <SolidColorBrush x:Key="Theme.ButtonHoverOverlay" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Theme.ButtonPressedOverlay" Color="#33FFFFFF" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="Theme.InputBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="Theme.InputBorderBrush" Color="#FF555555" />
    <SolidColorBrush x:Key="Theme.InputHoverBorderBrush" Color="#FF6E6E6E" />

    <!-- Popups / menus / tooltips -->
    <SolidColorBrush x:Key="Theme.PopupBackground" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="Theme.PopupBorderBrush" Color="#FF3F3F46" />

    <!-- Hover / selection -->
    <SolidColorBrush x:Key="Theme.HoverBackground" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Theme.PressedBackground" Color="#FF454545" />
    <SolidColorBrush x:Key="Theme.SelectionBackground" Color="#FF0078D7" />
    <SolidColorBrush x:Key="Theme.SelectionForeground" Color="#FFFFFFFF" />

    <!-- Tabs: inactive tabs sit slightly raised off the strip; the selected tab blends into
         the content area and gets an accent underline (see ControlStyles.xaml). -->
    <SolidColorBrush x:Key="Theme.TabBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="Theme.TabSelectedBackground" Color="#FF1E1E1E" />

    <!-- Scrollbars -->
    <SolidColorBrush x:Key="Theme.ScrollBarTrackBackground" Color="#FF262626" />
    <SolidColorBrush x:Key="Theme.ScrollBarThumbBackground" Color="#FF565656" />
    <SolidColorBrush x:Key="Theme.ScrollBarThumbHoverBackground" Color="#FF6E6E6E" />
    <SolidColorBrush x:Key="Theme.ScrollBarThumbPressedBackground" Color="#FF7A7A7A" />

    <!-- ToolTip -->
    <SolidColorBrush x:Key="Theme.ToolTipBackground" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="Theme.ToolTipBorderBrush" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="Theme.ToolTipForeground" Color="#FFE8E8E8" />

    <!-- Checkbox / radio -->
    <SolidColorBrush x:Key="Theme.CheckBoxBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="Theme.CheckBoxBorderBrush" Color="#FF6E6E6E" />

    <!-- Slider / progress -->
    <SolidColorBrush x:Key="Theme.SliderThumbBackground" Color="#FF0078D7" />
    <SolidColorBrush x:Key="Theme.SliderTrackBackground" Color="#FF565656" />
    <SolidColorBrush x:Key="Theme.ProgressBarBackground" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Theme.ProgressBarForeground" Color="#FF0078D7" />

    <!-- Cards / welcome / project picker -->
    <SolidColorBrush x:Key="Theme.CardBackground" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="Theme.CardBorderBrush" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="Theme.CardHoverBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="Theme.IconBackground" Color="#FF1E3A5F" />
    <SolidColorBrush x:Key="Theme.IconBackgroundWarm" Color="#FF4A3826" />

    <!-- Semantic colors -->
    <SolidColorBrush x:Key="Theme.DangerForeground" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="Theme.SuccessForeground" Color="#FF4CAF50" />
    <SolidColorBrush x:Key="Theme.InfoBannerBackground" Color="#FF3A2B45" />
    <SolidColorBrush x:Key="Theme.InfoBannerBorderBrush" Color="#FF6B21A8" />
    <SolidColorBrush x:Key="Theme.InfoBannerForeground" Color="#FFD8B8FF" />
    <SolidColorBrush x:Key="Theme.HyperlinkForeground" Color="#FF4DA3FF" />
</ResourceDictionary>
