<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core surfaces - GIMP-inspired darker theme -->
    <SolidColorBrush x:Key="Theme.WindowBackground" Color="#FF101010" />
    <SolidColorBrush x:Key="Theme.BarBackground" Color="#FF181818" />
    <SolidColorBrush x:Key="Theme.PanelBackground" Color="#FF141414" />
    <SolidColorBrush x:Key="Theme.PanelHeaderBackground" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="Theme.BorderBrush" Color="#FF282828" />
    <SolidColorBrush x:Key="Theme.ForegroundBrush" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="Theme.MutedForegroundBrush" Color="#FF888888" />
    <SolidColorBrush x:Key="Theme.SubtleForegroundBrush" Color="#FF666666" />
    <SolidColorBrush x:Key="Theme.DisabledForegroundBrush" Color="#FF555555" />

    <!-- Accent / primary action - GIMP-inspired accent color -->
    <SolidColorBrush x:Key="Theme.AccentBackground" Color="#FF4A90D9" />
    <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#FF5AA0E9" />
    <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#FF3A80C9" />
    <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFFFF" />

    <!-- Buttons - GIMP-inspired flatter buttons -->
    <SolidColorBrush x:Key="Theme.ButtonBackground" Color="#FF282828" />
    <SolidColorBrush x:Key="Theme.ButtonHoverBackground" Color="#FF383838" />
    <SolidColorBrush x:Key="Theme.ButtonPressedBackground" Color="#FF484848" />
    <SolidColorBrush x:Key="Theme.ButtonBorderBrush" Color="#FF383838" />
    <SolidColorBrush x:Key="Theme.ButtonHoverBorderBrush" Color="#FF4A90D9" />
    <!-- Translucent overlays on top of the button background, so hover/pressed feedback is
         visible on both plain and accent (e.g. blue "Apply") buttons without repainting them. -->
    <SolidColorBrush x:Key="Theme.ButtonHoverOverlay" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Theme.ButtonPressedOverlay" Color="#33FFFFFF" />

    <!-- Inputs - GIMP-inspired darker inputs -->
    <SolidColorBrush x:Key="Theme.InputBackground" Color="#FF202020" />
    <SolidColorBrush x:Key="Theme.InputBorderBrush" Color="#FF383838" />
    <SolidColorBrush x:Key="Theme.InputHoverBorderBrush" Color="#FF4A90D9" />

    <!-- Popups / menus / tooltips - GIMP-inspired darker popups -->
    <SolidColorBrush x:Key="Theme.PopupBackground" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="Theme.PopupBorderBrush" Color="#FF383838" />

    <!-- Hover / selection - GIMP-inspired -->
    <SolidColorBrush x:Key="Theme.HoverBackground" Color="#FF282828" />
    <SolidColorBrush x:Key="Theme.PressedBackground" Color="#FF383838" />
    <SolidColorBrush x:Key="Theme.SelectionBackground" Color="#FF4A90D9" />
    <SolidColorBrush x:Key="Theme.SelectionForeground" Color="#FFFFFFFF" />

    <!-- Tabs: inactive tabs sit slightly raised off the strip; the selected tab blends into
         the content area and gets an accent underline (see ControlStyles.xaml). -->
    <SolidColorBrush x:Key="Theme.TabBackground" Color="#FF282828" />
    <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#FF383838" />
    <SolidColorBrush x:Key="Theme.TabSelectedBackground" Color="#FF101010" />

    <!-- Scrollbars - GIMP-inspired -->
    <SolidColorBrush x:Key="Theme.ScrollBarTrackBackground" Color="#FF181818" />
    <SolidColorBrush x:Key="Theme.ScrollBarThumbBackground" Color="#FF383838" />
    <SolidColorBrush x:Key="Theme.ScrollBarThumbHoverBackground" Color="#FF484848" />
    <SolidColorBrush x:Key="Theme.ScrollBarThumbPressedBackground" Color="#FF585858" />

    <!-- ToolTip -->
    <SolidColorBrush x:Key="Theme.ToolTipBackground" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="Theme.ToolTipBorderBrush" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="Theme.ToolTipForeground" Color="#FFE8E8E8" />

    <!-- Checkbox / radio -->
    <SolidColorBrush x:Key="Theme.CheckBoxBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="Theme.CheckBoxBorderBrush" Color="#FF6E6E6E" />

    <!-- Slider / progress - GIMP-inspired -->
    <SolidColorBrush x:Key="Theme.SliderThumbBackground" Color="#FF4A90D9" />
    <SolidColorBrush x:Key="Theme.SliderTrackBackground" Color="#FF383838" />
    <SolidColorBrush x:Key="Theme.ProgressBarBackground" Color="#FF282828" />
    <SolidColorBrush x:Key="Theme.ProgressBarForeground" Color="#FF4A90D9" />

    <!-- Cards / welcome / project picker -->
    <SolidColorBrush x:Key="Theme.CardBackground" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="Theme.CardBorderBrush" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="Theme.CardHoverBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="Theme.IconBackground" Color="#FF1E3A5F" />
    <SolidColorBrush x:Key="Theme.IconBackgroundWarm" Color="#FF4A3826" />

    <!-- Semantic colors -->
    <SolidColorBrush x:Key="Theme.DangerForeground" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="Theme.SuccessForeground" Color="#FF4CAF50" />
    <SolidColorBrush x:Key="Theme.InfoBannerBackground" Color="#FF3A2B45" />
    <SolidColorBrush x:Key="Theme.InfoBannerBorderBrush" Color="#FF6B21A8" />
    <SolidColorBrush x:Key="Theme.InfoBannerForeground" Color="#FFD8B8FF" />
    <SolidColorBrush x:Key="Theme.HyperlinkForeground" Color="#FF4DA3FF" />
</ResourceDictionary>
