<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core surfaces -->
    <SolidColorBrush x:Key="Theme.WindowBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.BarBackground" Color="#FFF5F6F8" />
    <SolidColorBrush x:Key="Theme.PanelBackground" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="Theme.PanelHeaderBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.BorderBrush" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="Theme.ForegroundBrush" Color="#FF222222" />
    <SolidColorBrush x:Key="Theme.MutedForegroundBrush" Color="#FF666666" />
    <SolidColorBrush x:Key="Theme.SubtleForegroundBrush" Color="#FF888888" />
    <SolidColorBrush x:Key="Theme.DisabledForegroundBrush" Color="#FF9A9A9A" />

    <!-- Accent / primary action -->
    <SolidColorBrush x:Key="Theme.AccentBackground" Color="#FF0078D7" />
    <SolidColorBrush x:Key="Theme.AccentHoverBackground" Color="#FF1E86E5" />
    <SolidColorBrush x:Key="Theme.AccentPressedBackground" Color="#FF0060B0" />
    <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFFFF" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="Theme.ButtonBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.ButtonHoverBackground" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="Theme.ButtonPressedBackground" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="Theme.ButtonBorderBrush" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="Theme.ButtonHoverBorderBrush" Color="#FF0078D7" />
    <!-- Translucent overlays on top of the button background, so hover/pressed feedback is
         visible on both plain and accent (e.g. blue "Apply") buttons without repainting them. -->
    <SolidColorBrush x:Key="Theme.ButtonHoverOverlay" Color="#1F000000" />
    <SolidColorBrush x:Key="Theme.ButtonPressedOverlay" Color="#33000000" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="Theme.InputBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.InputBorderBrush" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="Theme.InputHoverBorderBrush" Color="#FF999999" />

    <!-- Popups / menus / tooltips -->
    <SolidColorBrush x:Key="Theme.PopupBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.PopupBorderBrush" Color="#FFCCCCCC" />

    <!-- Hover / selection -->
    <SolidColorBrush x:Key="Theme.HoverBackground" Color="#FFE8E8E8" />
    <SolidColorBrush x:Key="Theme.PressedBackground" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="Theme.SelectionBackground" Color="#FF0078D7" />
    <SolidColorBrush x:Key="Theme.SelectionForeground" Color="#FFFFFFFF" />

    <!-- Tabs: inactive tabs sit slightly raised off the strip; the selected tab blends into
         the content area and gets an accent underline (see ControlStyles.xaml). -->
    <SolidColorBrush x:Key="Theme.TabBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="Theme.TabSelectedBackground" Color="#FFFFFFFF" />

    <!-- Scrollbars -->
    <SolidColorBrush x:Key="Theme.ScrollBarTrackBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.ScrollBarThumbBackground" Color="#FFBFBFBF" />
    <SolidColorBrush x:Key="Theme.ScrollBarThumbHoverBackground" Color="#FFA6A6A6" />
    <SolidColorBrush x:Key="Theme.ScrollBarThumbPressedBackground" Color="#FF8C8C8C" />

    <!-- ToolTip -->
    <SolidColorBrush x:Key="Theme.ToolTipBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.ToolTipBorderBrush" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="Theme.ToolTipForeground" Color="#FF222222" />

    <!-- Checkbox / radio -->
    <SolidColorBrush x:Key="Theme.CheckBoxBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.CheckBoxBorderBrush" Color="#FF999999" />

    <!-- Slider / progress -->
    <SolidColorBrush x:Key="Theme.SliderThumbBackground" Color="#FF0078D7" />
    <SolidColorBrush x:Key="Theme.SliderTrackBackground" Color="#FFC8C8C8" />
    <SolidColorBrush x:Key="Theme.ProgressBarBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.ProgressBarForeground" Color="#FF0078D7" />

    <!-- Cards / welcome / project picker -->
    <SolidColorBrush x:Key="Theme.CardBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.CardBorderBrush" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="Theme.CardHoverBackground" Color="#FFF0F7FF" />
    <SolidColorBrush x:Key="Theme.IconBackground" Color="#FFE6F2FB" />
    <SolidColorBrush x:Key="Theme.IconBackgroundWarm" Color="#FFFBF0E6" />

    <!-- Semantic colors -->
    <SolidColorBrush x:Key="Theme.DangerForeground" Color="#FFB91C1C" />
    <SolidColorBrush x:Key="Theme.SuccessForeground" Color="#FF1E7A33" />
    <SolidColorBrush x:Key="Theme.InfoBannerBackground" Color="#FFF3E8FF" />
    <SolidColorBrush x:Key="Theme.InfoBannerBorderBrush" Color="#FFD8B4FE" />
    <SolidColorBrush x:Key="Theme.InfoBannerForeground" Color="#FF6B21A8" />
    <SolidColorBrush x:Key="Theme.HyperlinkForeground" Color="#FF0066CC" />
</ResourceDictionary>
