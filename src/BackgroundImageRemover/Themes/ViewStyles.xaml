<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared view-level building blocks used across the tool views. Unlike ControlStyles.xaml
        these are keyed resources, applied explicitly where needed.

        Note: the zoomable preview controls (ZoomableImageControl / ImagePreviewControl /
        CompareImageControl) deliberately keep their checkerboard and zoom HUD markup inline:
        unit tests instantiate them without an Application, so app-level StaticResources would
        not resolve there.
    -->

    <!-- Standard border around the image preview area (replaces the copy-pasted
         BorderBrush="#FF3A3A3A" BorderThickness="1" on ~23 views). -->
    <Style x:Key="PreviewBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="#FF3A3A3A" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Small color swatch used by the Uncrop color pickers. -->
    <Style x:Key="ColorSwatch" TargetType="Rectangle">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stroke" Value="#FF888888" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

</ResourceDictionary>
