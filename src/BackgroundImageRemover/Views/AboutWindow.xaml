<Window x:Class="BackgroundImageRemover.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Background Image Remover"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        Background="#FFF8F9FA">
    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="24" CornerRadius="8" Margin="12">
        <StackPanel MinWidth="340">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="48" Height="48" CornerRadius="24" Background="#FFE6F2FB" Margin="0,0,12,0">
                    <TextBlock Text="🖼" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Background Image Remover" FontSize="18" FontWeight="Bold" Foreground="#FF222222" />
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="#FF666666" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Remove image backgrounds, refine cutouts and edit photos with a suite of tools: AI (ONNX/SAM), GrabCut, chroma key, uncrop/outpainting, retouch, filters, transforms and more."
                       TextWrapping="Wrap" FontSize="12" Foreground="#FF444444" Margin="0,0,0,16" />

            <TextBlock x:Name="CopyrightText" Text="Open source project — contributions welcome." FontSize="11" Foreground="#FF888888" Margin="0,0,0,16" />

            <Button Content="OK" HorizontalAlignment="Right" Padding="18,6" MinWidth="80"
                    IsDefault="True" Click="Ok_Click" Cursor="Hand" />
        </StackPanel>
    </Border>
</Window>
