<UserControl x:Class="BackgroundImageRemover.Views.AdjustmentsToolSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
        </Style>
    </UserControl.Resources>
    <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
        <controls:ToolSessionHeader Badge="✨ COLOR &amp; ADJUSTMENTS" Accent="#FFD97706" />

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Theme.BarBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Side Adjustments Panel -->
        <Border DockPanel.Dock="Right" Width="300" Padding="14" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource Theme.PanelBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Color &amp; Visual Filters" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource Theme.ForegroundBrush}" />

                    <!-- Brightness -->
                    <controls:SliderField Header="Brightness" Value="{Binding AdjBrightness}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" ValueFormat="{}{0:0}"  />
<!-- Contrast -->
                    <controls:SliderField Header="Contrast" Value="{Binding AdjContrast}" Minimum="0.1" Maximum="3.0" SmallChange="0.05" LargeChange="0.2" ValueFormat="{}{0:0.00}x"  />
<!-- Saturation -->
                    <controls:SliderField Header="Saturation" Value="{Binding AdjSaturation}" Minimum="0.0" Maximum="3.0" SmallChange="0.05" LargeChange="0.2" ValueFormat="{}{0:0.00}x"  />
<!-- Hue Shift -->
                    <controls:SliderField Header="Hue Shift (°)" Value="{Binding AdjHueShift}" Minimum="-180" Maximum="180" SmallChange="1" LargeChange="15" ValueFormat="{}{0:0}°"  />
<!-- Color Temperature -->
                    <controls:SliderField Header="Temperature (Cool ↔ Warm)" Value="{Binding AdjTemperature}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" ValueFormat="{}{0:0}"  />
<!-- Tint -->
                    <controls:SliderField Header="Tint (Green ↔ Magenta)" Value="{Binding AdjTint}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" ValueFormat="{}{0:0}"  />
<!-- Vignette -->
                    <controls:SliderField Header="Vignette" Value="{Binding AdjVignette}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" ValueFormat="{}{0:P0}"  />
<!-- Blur -->
                    <controls:SliderField Header="Blur Radius" Value="{Binding AdjBlurRadius}" Minimum="0" Maximum="50" SmallChange="1" LargeChange="5" ValueFormat="{}{0}px"  />
<!-- Sharpen -->
                    <controls:SliderField Header="Sharpen Strength" Value="{Binding AdjSharpenStrength}" Minimum="0.0" Maximum="3.0" SmallChange="0.05" LargeChange="0.2" ValueFormat="{}{0:0.00}"  />
<!-- Exposure (gamma) -->
                    <controls:SliderField Header="Exposure (gamma)" Value="{Binding AdjExposure}" Minimum="0.2" Maximum="3.0" SmallChange="0.05" LargeChange="0.2" ValueFormat="{}{0:0.00}"  />
<!-- Highlights -->
                    <controls:SliderField Header="Highlights" Value="{Binding AdjHighlights}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" ValueFormat="{}{0:0}"  />
<!-- Shadows -->
                    <controls:SliderField Header="Shadows" Value="{Binding AdjShadows}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" ValueFormat="{}{0:0}"  />
<!-- Denoise -->
                    <controls:SliderField Header="Denoise" Value="{Binding AdjDenoise}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" ValueFormat="{}{0:P0}"  />
<!-- Vibrance -->
                    <controls:SliderField Header="Vibrance" Value="{Binding AdjVibrance}" Minimum="-1" Maximum="1" SmallChange="0.05" LargeChange="0.1" ValueFormat="{}{0:0.00}"  />
<!-- Clarity -->
                    <controls:SliderField Header="Clarity" Value="{Binding AdjClarity}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" ValueFormat="{}{0:P0}"  />
<!-- Fade -->
                    <controls:SliderField Header="Fade (matte film)" Value="{Binding AdjFade}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" ValueFormat="{}{0:P0}"  />
<!-- Grain -->
                    <controls:SliderField Header="Grain" Value="{Binding AdjGrain}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" ValueFormat="{}{0:P0}"  />
<!-- Monochrome -->
                    <controls:SliderField Header="Monochrome" Value="{Binding AdjMonochrome}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" ValueFormat="{}{0:P0}"  />
<!-- Dehaze -->
                    <controls:SliderField Header="Dehaze" Value="{Binding AdjDehaze}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" ValueFormat="{}{0:P0}"  />
<!-- Soften -->
                    <controls:SliderField Header="Soften (skin)" Value="{Binding AdjSoften}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" ValueFormat="{}{0:P0}"  />
<!-- Sepia tone -->
                    <controls:SliderField Header="Sepia tone" Value="{Binding AdjSepiaTone}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" ValueFormat="{}{0:P0}"  />
<!-- Invert -->
                    <controls:SliderField Header="Invert" Value="{Binding AdjInvertAmount}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" ValueFormat="{}{0:P0}"  />
<!-- Posterize -->
                    <controls:SliderField Header="Posterize levels (0 = off)" Value="{Binding AdjPosterizeLevels}" Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"  />
<CheckBox Content="✨ Auto-enhance (one click)" IsChecked="{Binding AdjAutoEnhance}" Margin="0,0,0,12" FontWeight="SemiBold" />

                    <CheckBox Content="Split Compare view" IsChecked="{Binding IsCompareMode}" Margin="0,0,0,12" FontWeight="SemiBold" />

                    <Button Content="↺ Reset to Default" Command="{Binding ResetAdjustmentsCommand}"
                            Height="30" Background="{DynamicResource Theme.PanelHeaderBackground}" Foreground="{DynamicResource Theme.ForegroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Canvas -->
        <Grid Margin="8">
            <controls:CompareImageControl BeforeSource="{Binding OriginalBitmap}" AfterSource="{Binding ResultBitmap}"
                                           DividerPosition="{Binding CompareDividerPosition}"
                                           Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Border BorderBrush="#FF3A3A3A" BorderThickness="1"
                    Visibility="{Binding IsCompareMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <controls:ZoomableImageControl ImageSource="{Binding ResultBitmap}" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
