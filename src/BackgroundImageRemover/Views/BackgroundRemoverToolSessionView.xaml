<UserControl x:Class="BackgroundImageRemover.Views.BackgroundRemoverToolSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1300">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="StrategyKindValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:StrategyKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
        </Style>
    </UserControl.Resources>

    <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}"
               Focusable="True" KeyDown="Root_KeyDown">
        <!-- Modal Tool Session Top Bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Theme.BarBackground}" Padding="12,8" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Tool identity badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Background="#FF1E7A33" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="✂ BACKGROUND REMOVER" Foreground="White" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Theme.ForegroundBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Actions: Apply (Enter) & Cancel (Esc) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="✕ Cancel (Esc)" Command="{Binding CancelCommand}"
                            Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource Theme.PanelBackground}" Foreground="{DynamicResource Theme.MutedForegroundBrush}"
                            BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" />
                    <Button Content="✓ Apply (Enter)" Command="{Binding ApplyCommand}"
                            Padding="16,6" Background="#FF1E7A33" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontWeight="Bold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Theme.BarBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BusyMessage}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Side Controls Panel -->
        <Border DockPanel.Dock="Right" Width="330" Padding="14" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource Theme.PanelBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Removal Strategy" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource Theme.ForegroundBrush}" />
                    <ComboBox ItemsSource="{Binding Source={StaticResource StrategyKindValues}}"
                              SelectedItem="{Binding SelectedStrategy}"
                              Margin="0,0,0,4" />
                    <TextBlock Text="Tip: press 1–8 to switch strategy (1 Chroma Key · 2 GrabCut · 3 ONNX · 4 SAM · 5 Flood Fill · 6 K-Means · 7 Otsu · 8 Magic Wand · 0 Edge/Contour)"
                               FontSize="10" Foreground="{DynamicResource Theme.MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <!-- Chroma Key options -->
                    <StackPanel Visibility="{Binding SelectedStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ChromaKey}">
                        <TextBlock Text="Detected background color:" />
                        <Rectangle Height="24" Fill="{Binding ChromaKey.DetectedColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" Margin="0,4,0,12" />
                        <TextBlock Text="Tolerance" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding ChromaKey.Tolerance}" TickFrequency="5" />
                        <CheckBox Content="Spill suppression" IsChecked="{Binding ChromaKey.SpillSuppression}" Margin="0,8,0,0" />
                        <CheckBox Content="🎯 Sample color by clicking image" IsChecked="{Binding SampleColorMode}" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- GrabCut options -->
                    <StackPanel Visibility="{Binding SelectedStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=GrabCut}">
                        <TextBlock Text="Mark the subject on the left image. Draw a rectangle around the subject, then refine with foreground/background scribbles. Handles appear after drawing so you can move or resize the rectangle." TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock Text="Draw:" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <UniformGrid Columns="2" Margin="0,0,0,4">
                            <RadioButton Content="Rectangle" GroupName="ScribbleModeBg" Margin="0,0,4,4"
                                         IsChecked="{Binding OriginalMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=DrawRect, Mode=OneWay}"
                                         Command="{Binding SetOriginalScribbleModeCommand}" CommandParameter="{x:Static models:InteractionMode.DrawRect}" />
                            <RadioButton Content="✏ Edit rect" GroupName="ScribbleModeBg" Margin="4,0,0,4"
                                         IsChecked="{Binding OriginalMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=EditRect, Mode=OneWay}"
                                         Command="{Binding SetOriginalScribbleModeCommand}" CommandParameter="{x:Static models:InteractionMode.EditRect}" />
                        </UniformGrid>
                        <TextBlock Text="Foreground / Background scribbles:" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <UniformGrid Columns="2" Margin="0,0,0,4">
                            <RadioButton Content="Foreground" GroupName="ScribbleModeBg" Margin="0,0,4,4"
                                         IsChecked="{Binding OriginalMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ScribbleForeground, Mode=OneWay}"
                                         Command="{Binding SetOriginalScribbleModeCommand}" CommandParameter="{x:Static models:InteractionMode.ScribbleForeground}" />
                            <RadioButton Content="Background" GroupName="ScribbleModeBg" Margin="4,0,0,4"
                                         IsChecked="{Binding OriginalMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ScribbleBackground, Mode=OneWay}"
                                         Command="{Binding SetOriginalScribbleModeCommand}" CommandParameter="{x:Static models:InteractionMode.ScribbleBackground}" />
                        </UniformGrid>
                        <TextBlock Text="Erase:" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <UniformGrid Columns="2" Margin="0,0,0,4">
                            <RadioButton Content="⌫ Erase FG" GroupName="ScribbleModeBg" Margin="0,0,4,4"
                                         IsChecked="{Binding OriginalMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=EraseForeground, Mode=OneWay}"
                                         Command="{Binding SetOriginalScribbleModeCommand}" CommandParameter="{x:Static models:InteractionMode.EraseForeground}" />
                            <RadioButton Content="⌫ Erase BG" GroupName="ScribbleModeBg" Margin="4,0,0,4"
                                         IsChecked="{Binding OriginalMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=EraseBackground, Mode=OneWay}"
                                         Command="{Binding SetOriginalScribbleModeCommand}" CommandParameter="{x:Static models:InteractionMode.EraseBackground}" />
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="↶ Undo" Command="{Binding UndoScribbleCommand}" Margin="0,0,4,0" Padding="8,3" />
                            <Button Content="↷ Redo" Command="{Binding RedoScribbleCommand}" Margin="0,0,8,0" Padding="8,3" />
                            <Button Content="Update preview" Command="{Binding RefineGrabCutPreviewCommand}"
                                    Visibility="{Binding GrabCut.HasScribbles, Converter={StaticResource BoolToVisibilityConverter}}" Padding="8,3" />
                        </StackPanel>
                    </StackPanel>



                    <!-- ONNX options -->
                    <StackPanel Visibility="{Binding SelectedStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Onnx}">
                        <TextBlock Text="AI Model" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Onnx.AvailableModels}" SelectedItem="{Binding Onnx.SelectedModel}" Margin="0,0,0,8" />
                        <StackPanel Visibility="{Binding Onnx.IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Downloading model..." Margin="0,0,0,4" />
                            <ProgressBar Height="16" Minimum="0" Maximum="1" Value="{Binding Onnx.DownloadFraction, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Onnx.ErrorMessage}" Foreground="{DynamicResource Theme.DangerForeground}" TextWrapping="Wrap"
                                   Visibility="{Binding Onnx.ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                        <Button Content="Retry download" Command="{Binding RetryOnnxDownloadCommand}"
                                Visibility="{Binding Onnx.ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,4,0,8" />
                        <TextBlock Text="Edge feather" Margin="0,8,0,0" />
                        <Slider Minimum="0" Maximum="15" Value="{Binding Onnx.FeatherPixels}" />
                        <CheckBox Content="Alpha matting refinement (slower)" IsChecked="{Binding Onnx.EnableAlphaMatting}" Margin="0,8,0,0" />
                        <CheckBox Content="Use GPU (DirectML)" IsChecked="{Binding UseGpuForOnnx}" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- SAM options -->
                    <StackPanel Visibility="{Binding SelectedStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Sam}">
                        <TextBlock Text="Click on the subject in the Original image. Additional clicks refine the selection." TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Sam.AdditionalPointCount, StringFormat='Additional points: {0}'}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Clear all points" Command="{Binding ClearSamPointsCommand}" Padding="8,3" Margin="0,0,4,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Sam.HasClickedPoint, StringFormat='Point selected: {0}'}" Margin="0,0,0,8" />
                        <StackPanel Visibility="{Binding Sam.IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Downloading SAM model..." Margin="0,0,0,4" />
                            <ProgressBar Height="16" Minimum="0" Maximum="1" Value="{Binding Sam.DownloadFraction, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Sam.ErrorMessage}" Foreground="{DynamicResource Theme.DangerForeground}" TextWrapping="Wrap"
                                   Visibility="{Binding Sam.ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                        <Button Content="Retry download" Command="{Binding RetrySamDownloadCommand}"
                                Visibility="{Binding Sam.ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,4,0,8" />
                    </StackPanel>

                    <!-- Flood fill options -->
                    <StackPanel Visibility="{Binding SelectedStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=FloodFill}">
                        <TextBlock Text="Removes the connected background region starting from the image border." TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="Tolerance" />
                        <Slider Minimum="1" Maximum="100" Value="{Binding FloodFill.Tolerance}" />
                    </StackPanel>

                    <!-- K-Means options -->
                    <StackPanel Visibility="{Binding SelectedStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=KMeans}">
                        <TextBlock Text="Clusters the image colors and removes the clusters touching the border." TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="Clusters" />
                        <Slider Minimum="2" Maximum="8" Value="{Binding KMeans.ClusterCount}" IsSnapToTickEnabled="True" TickFrequency="1" />
                    </StackPanel>

                    <!-- Otsu options -->
                    <StackPanel Visibility="{Binding SelectedStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Otsu}">
                        <TextBlock Text="Automatic Otsu threshold for high-contrast subjects on a flat background." TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Magic Wand options -->
                    <StackPanel Visibility="{Binding SelectedStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=MagicWand}">
                        <TextBlock Text="Click on the background in the Original image to remove the connected region." TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding MagicWand.HasClickedPoint, StringFormat='Point selected: {0}'}" Margin="0,0,0,8" />
                        <TextBlock Text="Tolerance" />
                        <Slider Minimum="1" Maximum="100" Value="{Binding MagicWand.Tolerance}" />
                    </StackPanel>

                    <!-- Global finishing controls, applied to every strategy -->
                    <Separator Margin="0,16,0,8" />
                    <TextBlock Text="Refinement" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource Theme.ForegroundBrush}" />
                    <CheckBox Content="Invert mask (keep background)" IsChecked="{Binding InvertMask}" Margin="0,0,0,8" />
                    <TextBlock Text="Edge feather" />
                    <Slider Minimum="0" Maximum="30" Value="{Binding MaskFeatherPixels}" TickFrequency="1" IsSnapToTickEnabled="True" />

                    <TextBlock Text="Despeckle" Margin="0,8,0,0" />
                    <Slider Minimum="0" Maximum="15" Value="{Binding DespeckleKernelSize}" TickFrequency="1" IsSnapToTickEnabled="True" />

                    <TextBlock Text="Fill holes" Margin="0,8,0,0" />
                    <Slider Minimum="0" Maximum="15" Value="{Binding FillHolesKernelSize}" TickFrequency="1" IsSnapToTickEnabled="True" />

                    <TextBlock Text="Edge smoothing" Margin="0,8,0,0" />
                    <Slider Minimum="0" Maximum="15" Value="{Binding SmoothEdgesKernelSize}" TickFrequency="1" IsSnapToTickEnabled="True" />

                    <CheckBox Content="Keep largest subject only" IsChecked="{Binding KeepLargestComponent}" Margin="0,8,0,0" />

                    <TextBlock Text="Grow / shrink subject" Margin="0,8,0,0" />
                    <Slider Minimum="-30" Maximum="30" Value="{Binding MaskExpandPixels}" TickFrequency="1" IsSnapToTickEnabled="True" />

                    <TextBlock Text="Edge blur" Margin="0,8,0,0" />
                    <Slider Minimum="0" Maximum="15" Value="{Binding MaskBlurPixels}" TickFrequency="0.5" />

                    <TextBlock Text="Min component area (px)" Margin="0,8,0,0" />
                    <Slider Minimum="0" Maximum="500" Value="{Binding MinComponentAreaPixels}" TickFrequency="10" />

                    <TextBlock Text="Mask gamma" Margin="0,8,0,0" />
                    <Slider Minimum="0.2" Maximum="5" Value="{Binding MaskGamma}" TickFrequency="0.1" />

                    <TextBlock Text="Edge hardness" Margin="0,8,0,0" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding MaskHardness}" TickFrequency="0.05" />

                    <TextBlock Text="Alpha cut (below = removed)" Margin="0,8,0,0" />
                    <Slider Minimum="0" Maximum="255" Value="{Binding MaskThreshold}" TickFrequency="1" />

                    <TextBlock Text="Despill strength" Margin="0,8,0,0" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding DespillStrength}" TickFrequency="0.05" />

                    <TextBlock Text="Median cleanup" Margin="0,8,0,0" />
                    <Slider Minimum="0" Maximum="15" Value="{Binding MaskMedianKernel}" TickFrequency="2" IsSnapToTickEnabled="True" />

                    <TextBlock Text="Bilateral cleanup" Margin="0,8,0,0" />
                    <Slider Minimum="0" Maximum="15" Value="{Binding MaskBilateralKernel}" TickFrequency="2" IsSnapToTickEnabled="True" />

                    <CheckBox Content="Alpha contrast (CLAHE)" IsChecked="{Binding MaskClahe}" Margin="0,8,0,0" />

                    <!-- Export background options (persisted to the parent document) -->
                    <Separator Margin="0,16,0,8" />
                    <TextBlock Text="Export background" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource Theme.ForegroundBrush}" />
                    <RadioButton Content="Transparent" GroupName="ExportBgSession" Margin="0,0,0,4"
                                 IsChecked="{Binding ParentDocument.ExportBackgroundMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Transparent}" />
                    <RadioButton Content="Solid color" GroupName="ExportBgSession" Margin="0,0,0,4"
                                 IsChecked="{Binding ParentDocument.ExportBackgroundMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SolidColor}" />
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ParentDocument.ExportBackgroundMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=SolidColor}"
                                Margin="16,0,0,8">
                        <Rectangle Width="24" Height="24" Fill="{Binding ParentDocument.ExportSolidColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" />
                        <Button x:Name="ChooseSolidColorButton" Content="Choose..." Margin="8,0,0,0" Click="ChooseSolidColorButton_Click" />
                        <Popup IsOpen="{Binding ParentDocument.IsColorPickerOpen}" PlacementTarget="{Binding ElementName=ChooseSolidColorButton}"
                               StaysOpen="False" AllowsTransparency="True" Placement="Right">
                            <Border Background="{DynamicResource Theme.PopupBackground}" BorderBrush="{DynamicResource Theme.PopupBorderBrush}" BorderThickness="1">
                                <controls:SimpleColorPickerControl SelectedColor="{Binding ParentDocument.ExportSolidColor}" />
                            </Border>
                        </Popup>
                    </StackPanel>
                    <RadioButton Content="Image" GroupName="ExportBgSession" Margin="0,0,0,4"
                                 IsChecked="{Binding ParentDocument.ExportBackgroundMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Image}" />
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ParentDocument.ExportBackgroundMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Image}"
                                Margin="16,0,0,8">
                        <Button Content="Choose image..." Command="{Binding ParentDocument.PickBackgroundImageCommand}" />
                    </StackPanel>
                    <RadioButton Content="Blur (portrait mode)" GroupName="ExportBgSession" Margin="0,0,0,4"
                                 IsChecked="{Binding ParentDocument.ExportBackgroundMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Blur}" />
                    <StackPanel Visibility="{Binding ParentDocument.ExportBackgroundMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Blur}" Margin="16,0,0,8">
                        <TextBlock Text="Blur radius" />
                        <Slider Minimum="0" Maximum="50" Value="{Binding ParentDocument.ExportBlurRadius}" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </StackPanel>
                    <RadioButton Content="Gradient" GroupName="ExportBgSession" Margin="0,0,0,4"
                                 IsChecked="{Binding ParentDocument.ExportBackgroundMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Gradient}" />
                    <StackPanel Visibility="{Binding ParentDocument.ExportBackgroundMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Gradient}" Margin="16,0,0,8">
                        <TextBlock Text="Top color" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Rectangle Width="24" Height="24" Fill="{Binding ParentDocument.ExportGradientTopColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" />
                            <Button x:Name="ChooseGradientTopColorButton" Content="Choose..." Margin="8,0,0,0" Click="ChooseGradientTopColorButton_Click" />
                            <Popup IsOpen="{Binding ParentDocument.IsGradientTopColorPickerOpen}" PlacementTarget="{Binding ElementName=ChooseGradientTopColorButton}"
                                   StaysOpen="False" AllowsTransparency="True" Placement="Right">
                                <Border Background="{DynamicResource Theme.PopupBackground}" BorderBrush="{DynamicResource Theme.PopupBorderBrush}" BorderThickness="1">
                                    <controls:SimpleColorPickerControl SelectedColor="{Binding ParentDocument.ExportGradientTopColor}" />
                                </Border>
                            </Popup>
                        </StackPanel>
                        <TextBlock Text="Bottom color" />
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="24" Height="24" Fill="{Binding ParentDocument.ExportGradientBottomColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" />
                            <Button x:Name="ChooseGradientBottomColorButton" Content="Choose..." Margin="8,0,0,0" Click="ChooseGradientBottomColorButton_Click" />
                            <Popup IsOpen="{Binding ParentDocument.IsGradientBottomColorPickerOpen}" PlacementTarget="{Binding ElementName=ChooseGradientBottomColorButton}"
                                   StaysOpen="False" AllowsTransparency="True" Placement="Right">
                                <Border Background="{DynamicResource Theme.PopupBackground}" BorderBrush="{DynamicResource Theme.PopupBorderBrush}" BorderThickness="1">
                                    <controls:SimpleColorPickerControl SelectedColor="{Binding ParentDocument.ExportGradientBottomColor}" />
                                </Border>
                            </Popup>
                        </StackPanel>
                    </StackPanel>

                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Output quality" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding ParentDocument.ExportJpegQuality, StringFormat='{}{0:0}'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="1" Maximum="100" Value="{Binding ParentDocument.ExportJpegQuality}" TickFrequency="1" IsSnapToTickEnabled="True"
                            ToolTip="Quality used when exporting JPEG or WebP" />

                    <!-- Drop shadow (applies to every background mode) -->
                    <CheckBox Content="Drop shadow" IsChecked="{Binding ParentDocument.ExportDropShadowEnabled}" Margin="0,8,0,4" />
                    <StackPanel Visibility="{Binding ParentDocument.ExportDropShadowEnabled, Converter={StaticResource BoolToVisibilityConverter}}" Margin="16,0,0,8">
                        <TextBlock Text="Offset" />
                        <Slider Minimum="0" Maximum="60" Value="{Binding ParentDocument.ExportShadowOffset}" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Text="Blur" />
                        <Slider Minimum="0" Maximum="40" Value="{Binding ParentDocument.ExportShadowBlur}" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Text="Opacity" />
                        <Slider Minimum="0" Maximum="1" Value="{Binding ParentDocument.ExportShadowOpacity}" TickFrequency="0.05" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Image Panes -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Original (Select rect / scribbles / SAM point)" FontWeight="Bold" Margin="0,0,0,4" />
                <controls:ImagePreviewControl x:Name="OriginalPreview"
                                               ImageSource="{Binding PreviewBitmap}"
                                               ScribbleOverlay="{Binding ScribbleOverlay}"
                                               Mode="{Binding OriginalMode}"
                                               RectSelected="OriginalPreview_RectSelected"
                                               EditRectSelected="OriginalPreview_EditRectSelected"
                                               StrokeStart="OriginalPreview_StrokeStart"
                                               StrokeMove="OriginalPreview_StrokeMove"
                                               StrokeEnd="OriginalPreview_StrokeEnd"
                                               SamPointClicked="OriginalPreview_SamPointClicked"
                                               WandClicked="OriginalPreview_WandClicked" />
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Cutout Result Preview" FontWeight="Bold" Margin="0,0,0,4" />
                <Border BorderBrush="#FF3A3A3A" BorderThickness="1">
                    <controls:ZoomableImageControl ImageSource="{Binding ResultBitmap}" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
