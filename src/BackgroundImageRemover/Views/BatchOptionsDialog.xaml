<Window x:Class="BackgroundImageRemover.Views.BatchOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
        Title="Batch Output Options"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}"
        Background="{DynamicResource Theme.WindowBackground}">
    <Border BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Padding="22" CornerRadius="8" Margin="12">
        <StackPanel MinWidth="360">
            <TextBlock Text="Output format" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,8" />

            <RadioButton Content="PNG — keep transparency" GroupName="BatchFormat" Margin="0,0,0,4"
                         IsChecked="{Binding OutputKind, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Png}" />
            <RadioButton Content="WebP — keep transparency, smaller files" GroupName="BatchFormat" Margin="0,0,0,4"
                         IsChecked="{Binding OutputKind, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Webp}" />

            <RadioButton Content="JPEG — white background" GroupName="BatchFormat" Margin="0,0,0,4"
                         IsChecked="{Binding OutputKind, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JpegWhite}" />

            <RadioButton Content="JPEG — solid color" GroupName="BatchFormat" Margin="0,0,0,4"
                         IsChecked="{Binding OutputKind, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JpegSolid}" />
            <StackPanel Orientation="Horizontal" Margin="18,0,0,6"
                        Visibility="{Binding OutputKind, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=JpegSolid}">
                <Rectangle Width="24" Height="24" Fill="{Binding SolidColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" VerticalAlignment="Center" />
                <Button x:Name="ChooseSolidButton" Content="Choose..." Margin="8,0,0,0" Click="ChooseSolid_Click" />
                <Popup IsOpen="{Binding IsSolidPickerOpen}" PlacementTarget="{Binding ElementName=ChooseSolidButton}" StaysOpen="False" AllowsTransparency="True" Placement="Right">
                    <Border Background="{DynamicResource Theme.PopupBackground}" BorderBrush="{DynamicResource Theme.PopupBorderBrush}" BorderThickness="1">
                        <controls:SimpleColorPickerControl SelectedColor="{Binding SolidColor}" />
                    </Border>
                </Popup>
            </StackPanel>

            <RadioButton Content="JPEG — gradient" GroupName="BatchFormat" Margin="0,0,0,4"
                         IsChecked="{Binding OutputKind, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JpegGradient}" />
            <StackPanel Margin="18,0,0,6"
                        Visibility="{Binding OutputKind, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=JpegGradient}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Top" VerticalAlignment="Center" Width="36" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" />
                    <Rectangle Width="24" Height="24" Fill="{Binding GradientTop, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" />
                    <Button x:Name="ChooseTopButton" Content="Choose..." Margin="8,0,0,0" Click="ChooseTop_Click" />
                    <Popup IsOpen="{Binding IsTopPickerOpen}" PlacementTarget="{Binding ElementName=ChooseTopButton}" StaysOpen="False" AllowsTransparency="True" Placement="Right">
                        <Border Background="{DynamicResource Theme.PopupBackground}" BorderBrush="{DynamicResource Theme.PopupBorderBrush}" BorderThickness="1">
                            <controls:SimpleColorPickerControl SelectedColor="{Binding GradientTop}" />
                        </Border>
                    </Popup>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Bottom" VerticalAlignment="Center" Width="36" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" />
                    <Rectangle Width="24" Height="24" Fill="{Binding GradientBottom, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" />
                    <Button x:Name="ChooseBottomButton" Content="Choose..." Margin="8,0,0,0" Click="ChooseBottom_Click" />
                    <Popup IsOpen="{Binding IsBottomPickerOpen}" PlacementTarget="{Binding ElementName=ChooseBottomButton}" StaysOpen="False" AllowsTransparency="True" Placement="Right">
                        <Border Background="{DynamicResource Theme.PopupBackground}" BorderBrush="{DynamicResource Theme.PopupBorderBrush}" BorderThickness="1">
                            <controls:SimpleColorPickerControl SelectedColor="{Binding GradientBottom}" />
                        </Border>
                    </Popup>
                </StackPanel>
            </StackPanel>

            <RadioButton Content="JPEG — background image" GroupName="BatchFormat" Margin="0,0,0,4"
                         IsChecked="{Binding OutputKind, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JpegImage}" />
            <StackPanel Orientation="Horizontal" Margin="18,0,0,6"
                        Visibility="{Binding OutputKind, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=JpegImage}">
                <TextBlock Text="{Binding BackgroundImagePath, TargetNullValue='(none)'}" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource Theme.MutedForegroundBrush}" MaxWidth="220" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding BackgroundImagePath}" />
                <Button x:Name="ChooseBackgroundImageButton" Content="Choose..." Margin="8,0,0,0"
                        Click="ChooseBackgroundImage_Click" />
            </StackPanel>

            <RadioButton Content="JPEG — blurred original" GroupName="BatchFormat" Margin="0,0,0,8"
                         IsChecked="{Binding OutputKind, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=JpegBlur}" />

            <controls:SliderField Header="Image quality" Value="{Binding JpegQuality}" Minimum="50" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueFormat="{}{0:0}"  />
<CheckBox Content="Skip files whose output already exists" IsChecked="{Binding SkipExisting}" Margin="0,0,0,16"
                      ToolTip="Re-running a batch will only process files that have no cutout yet in the output folder" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0" Cursor="Hand" />
                <Button Content="OK" IsDefault="True" Click="Ok_Click" Padding="20,6" Background="{DynamicResource Theme.AccentBackground}" Foreground="{DynamicResource Theme.AccentForeground}" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
