<UserControl x:Class="BackgroundImageRemover.Views.CloneStampToolSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource Theme.BarBackground}" Padding="12,8" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Background="#FF059669" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="🖼 CLONE STAMP" Foreground="White" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Theme.ForegroundBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="✕ Cancel (Esc)" Command="{Binding CancelCommand}" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource Theme.PanelBackground}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" />
                    <Button Content="✓ Apply (Enter)" Command="{Binding ApplyCommand}" Padding="16,6" Background="#FF059669" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Theme.BarBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <StatusBarItem><TextBlock Text="{Binding StatusMessage}" /></StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Right" Width="300" Padding="14" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource Theme.PanelBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Clone Stamp" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource Theme.ForegroundBrush}" />

                    <TextBlock Text="Source point:" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding SourceX, StringFormat='{}{0:0}'}" Width="60" Margin="0,0,8,0" />
                        <TextBlock Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding SourceY, StringFormat='{}{0:0}'}" Width="60" />
                    </StackPanel>

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Brush size" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding BrushRadius, StringFormat='{}{0:0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="2" Maximum="150" Value="{Binding BrushRadius}" Margin="0,2,0,8" />

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Opacity" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding Opacity, StringFormat='{}{0:P0}'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="0.05" Maximum="1" Value="{Binding Opacity}" SmallChange="0.05" LargeChange="0.1" Margin="0,2,0,8" />

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Hardness" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding Hardness, StringFormat='{}{0:P0}'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="0.95" Value="{Binding Hardness}" SmallChange="0.05" Margin="0,2,0,8" />

                    <Button Content="↺ Reset" Command="{Binding ResetCommand}" Height="30" Background="{DynamicResource Theme.PanelHeaderBackground}" Foreground="{DynamicResource Theme.ForegroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Margin="8">
            <Border BorderBrush="#FF3A3A3A" BorderThickness="1">
                <controls:ImagePreviewControl x:Name="CloneStampPreview"
                                               ImageSource="{Binding ResultBitmap}"
                                               Mode="{Binding Source={x:Static models:InteractionMode.Brush}}"
                                               BrushRadius="{Binding BrushRadius}"
                                               StrokeStart="CloneStampPreview_StrokeStart"
                                               StrokeMove="CloneStampPreview_StrokeMove"
                                               StrokeEnd="CloneStampPreview_StrokeEnd" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
