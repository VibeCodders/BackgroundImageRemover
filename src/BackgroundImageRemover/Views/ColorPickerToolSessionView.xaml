<UserControl x:Class="BackgroundImageRemover.Views.ColorPickerToolSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource Theme.BarBackground}" Padding="12,8" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Background="#FF0EA5E9" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="🎨 COLOR PICKER" Foreground="White" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Theme.ForegroundBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="✕ Cancel (Esc)" Command="{Binding CancelCommand}" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource Theme.PanelBackground}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" />
                    <Button Content="✓ Apply (Enter)" Command="{Binding ApplyCommand}" Padding="16,6" Background="#FF0EA5E9" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Theme.BarBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <StatusBarItem><TextBlock Text="{Binding StatusMessage}" /></StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Right" Width="300" Padding="14" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource Theme.PanelBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Color Picker" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource Theme.ForegroundBrush}" />

                    <TextBlock Text="Click on the image to sample a color." Margin="0,0,0,12"
                               Foreground="{DynamicResource Theme.MutedForegroundBrush}" TextWrapping="Wrap" />

                    <CheckBox Content="Average sample" IsChecked="{Binding AverageSample}" Margin="0,0,0,8" />
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Brush size" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding BrushRadius, StringFormat='{}{0:0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="1" Maximum="50" Value="{Binding BrushRadius}" Margin="0,2,0,12" />

                    <Border Background="{DynamicResource Theme.PanelHeaderBackground}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,1,0,0" Padding="8,8" CornerRadius="4">
                        <Rectangle Width="40" Height="40" Fill="{Binding HexColor}" Stroke="{DynamicResource Theme.BorderBrush}" StrokeThickness="1" />
                    </Border>

                    <TextBlock Text="{Binding HexColor}" FontWeight="Bold" FontSize="16" Margin="0,8,0,4" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding RgbString}"
                               Foreground="{DynamicResource Theme.MutedForegroundBrush}" Margin="0,0,0,8" HorizontalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Copy Hex" Command="{Binding CopyHexCommand}" Padding="8,4" Margin="0,0,8,0" />
                        <Button Content="Copy RGB" Command="{Binding CopyRgbCommand}" Padding="8,4" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Margin="8">
            <Border BorderBrush="#FF3A3A3A" BorderThickness="1">
                <controls:ZoomableImageControl x:Name="ColorPickerPreview"
                                               ImageSource="{Binding PreviewBitmap}"
                                               MouseLeftButtonDown="ColorPickerPreview_MouseLeftButtonDown" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
