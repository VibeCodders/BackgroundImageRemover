<UserControl x:Class="BackgroundImageRemover.Views.Controls.ColorPickerField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             mc:Ignorable="d"
             d:DesignWidth="260">
    <StackPanel Margin="0,0,0,12">
        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
            <Rectangle Width="24" Height="24"
                       Fill="{Binding SelectedColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColorToBrushConverter}}"
                       Stroke="Gray" />
            <Button x:Name="ChooseColorButton" Content="Choose color..." Margin="8,0,0,0" Click="ChooseColorButton_Click" />
            <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ChooseColorButton}"
                   StaysOpen="False" AllowsTransparency="True" Placement="Right">
                <Border Background="{DynamicResource Theme.PopupBackground}" BorderBrush="{DynamicResource Theme.PopupBorderBrush}" BorderThickness="1">
                    <controls:SimpleColorPickerControl SelectedColor="{Binding SelectedColor, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                </Border>
            </Popup>
        </StackPanel>
    </StackPanel>
</UserControl>
