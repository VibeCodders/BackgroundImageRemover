<UserControl x:Class="BackgroundImageRemover.Views.Controls.CompareImageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="400">
    <Grid x:Name="RootGrid" ClipToBounds="True" SizeChanged="RootGrid_SizeChanged">
        <Grid.Background>
            <!-- Fully opaque transparency checkerboard: white + light-gray tiles, so it renders
                 the same regardless of the window theme. -->
            <VisualBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                <VisualBrush.Visual>
                    <Grid Width="16" Height="16">
                        <Rectangle Width="8" Height="8" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Rectangle Width="8" Height="8" Fill="#FFE0E0E0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <Rectangle Width="8" Height="8" Fill="#FFE0E0E0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <Rectangle Width="8" Height="8" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.Background>

        <Image x:Name="BeforeImage" Stretch="Uniform" Source="{Binding BeforeSource, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <Image x:Name="AfterImage" Stretch="Uniform" Source="{Binding AfterSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Image.Clip>
                <RectangleGeometry x:Name="AfterClip" />
            </Image.Clip>
        </Image>

        <Rectangle x:Name="DividerLine" Width="2" Fill="White" HorizontalAlignment="Left" IsHitTestVisible="False" />

        <Thumb x:Name="DividerThumb" Width="20" HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Background="Transparent" Cursor="SizeWE" DragDelta="DividerThumb_DragDelta" />
    </Grid>
</UserControl>
