<UserControl x:Class="BackgroundImageRemover.Views.Controls.ImagePreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             ClipToBounds="True"
             d:DesignHeight="400" d:DesignWidth="400">
    <Grid x:Name="RootGrid"
          MouseWheel="RootGrid_MouseWheel"
          MouseDown="RootGrid_MouseDown"
          MouseMove="RootGrid_MouseMove"
          MouseUp="RootGrid_MouseUp"
          MouseLeave="RootGrid_MouseLeave">
        <Grid.Background>
            <!-- Fully opaque transparency checkerboard: white + light-gray tiles, so it renders
                 the same regardless of the window theme. -->
            <VisualBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                <VisualBrush.Visual>
                    <Grid Width="16" Height="16">
                        <Rectangle Width="8" Height="8" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Rectangle Width="8" Height="8" Fill="#FFE0E0E0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <Rectangle Width="8" Height="8" Fill="#FFE0E0E0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <Rectangle Width="8" Height="8" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.Background>

        <Grid x:Name="ZoomPanHost">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PanTranslate" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="ImageHost" Stretch="Uniform" Source="{Binding ImageSource, RelativeSource={RelativeSource AncestorType=UserControl}}" />

            <!-- Scribbles are drawn here as a bitmap overlay (aligned with the image via the
                 same Uniform stretch), so partial erasure, undo and redo all stay in sync with
                 the ViewModel's scribble masks without manual stroke bookkeeping. -->
            <Image x:Name="ScribbleOverlayImage" Stretch="Uniform" IsHitTestVisible="False"
                   Source="{Binding ScribbleOverlay, RelativeSource={RelativeSource AncestorType=UserControl}}" />

            <Canvas x:Name="OverlayCanvas" Background="Transparent">
                <Rectangle x:Name="SelectionRectangle"
                           Stroke="DodgerBlue" StrokeThickness="2" StrokeDashArray="4 2"
                           Fill="#220096FF" Visibility="Collapsed" />
                <Ellipse x:Name="SamPointMarker" Width="14" Height="14" Fill="Yellow" Stroke="Black" StrokeThickness="1.5"
                         Visibility="Collapsed" IsHitTestVisible="False" />
                <Ellipse x:Name="WandPointMarker" Width="12" Height="12" Fill="#33FF7F50" Stroke="Orange" StrokeThickness="1.5"
                         Visibility="Collapsed" IsHitTestVisible="False" />
                <Ellipse x:Name="BrushCursorPreview" Width="40" Height="40" Stroke="#FF0EA5E9" StrokeThickness="1.5"
                         Fill="#330EA5E9" Visibility="Collapsed" IsHitTestVisible="False" />
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
