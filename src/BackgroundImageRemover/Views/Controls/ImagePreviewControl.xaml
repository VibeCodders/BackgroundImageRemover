<UserControl x:Class="BackgroundImageRemover.Views.Controls.ImagePreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="400">
    <Grid>
        <Grid.Background>
            <VisualBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                <VisualBrush.Visual>
                    <Grid Width="16" Height="16">
                        <Rectangle Width="8" Height="8" Fill="#FFE0E0E0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Rectangle Width="8" Height="8" Fill="#FFE0E0E0" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        <Rectangle Width="16" Height="16" Fill="#FFFFFFFF" Opacity="0" />
                    </Grid>
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.Background>

        <Image x:Name="ImageHost" Stretch="Uniform" Source="{Binding ImageSource, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <Canvas x:Name="OverlayCanvas"
                Background="Transparent"
                IsHitTestVisible="{Binding IsRectDrawingEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                MouseMove="OverlayCanvas_MouseMove"
                MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp">
            <Rectangle x:Name="SelectionRectangle"
                       Stroke="DodgerBlue"
                       StrokeThickness="2"
                       StrokeDashArray="4 2"
                       Fill="#220096FF"
                       Visibility="Collapsed" />
        </Canvas>
    </Grid>
</UserControl>
