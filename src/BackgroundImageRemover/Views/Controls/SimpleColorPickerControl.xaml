<UserControl x:Class="BackgroundImageRemover.Views.Controls.SimpleColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="220">
    <StackPanel Margin="10" Width="200">
        <Rectangle x:Name="Swatch" Height="32" Stroke="Gray" Margin="0,0,0,8" />

        <TextBlock Text="R" />
        <Slider x:Name="RedSlider" Minimum="0" Maximum="255" ValueChanged="ChannelSlider_ValueChanged" />
        <TextBlock Text="G" />
        <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" ValueChanged="ChannelSlider_ValueChanged" />
        <TextBlock Text="B" />
        <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" ValueChanged="ChannelSlider_ValueChanged" />
    </StackPanel>
</UserControl>
