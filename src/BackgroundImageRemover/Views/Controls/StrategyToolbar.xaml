                            <Binding Path="ActiveTool" />
                            <Binding Path="SelectedStrategy" />
                        </MultiBinding>
                    </RadioButton.IsChecked>
                    <Path Data="{StaticResource OtsuIcon}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          Stretch="Uniform"
                          Width="24" Height="24" />
                </RadioButton>

                <RadioButton GroupName="EditorTools"
                             Style="{StaticResource StrategyToolButton}"
                             Command="{Binding OpenBackgroundRemovalToolCommand}"
                             CommandParameter="{x:Static models:StrategyKind.Inpaint}"
                             ToolTip="Inpaint (flood + fill background)">
                    <RadioButton.IsChecked>
                        <MultiBinding Converter="{StaticResource ActiveStrategyToBoolConverter}" ConverterParameter="Inpaint">
                            <Binding Path="ActiveTool" />
                            <Binding Path="SelectedStrategy" />
                        </MultiBinding>
                    </RadioButton.IsChecked>
                    <Path Data="{StaticResource InpaintIcon}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          Stretch="Uniform"
                          Width="24" Height="24" />
                </RadioButton>

                <Separator Background="{DynamicResource Theme.BorderBrush}" Margin="0,4" />

                <!-- SELECTION TOOLS -->
                <TextBlock Text="Selection" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.MutedForegroundBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,6" FontSize="9" />

                <RadioButton GroupName="EditorTools"
                             Style="{StaticResource StrategyToolButton}"
                             Command="{Binding OpenToolTabCommand}" 
                             CommandParameter="{x:Static models:EditorTool.Crop}"
                             ToolTip="Crop (E)"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Crop}">
                    <Path Data="{StaticResource CropIcon}" 
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          Stretch="Uniform" 
                          Width="24" Height="24" />
                </RadioButton>

                <Separator Background="{DynamicResource Theme.BorderBrush}" Margin="0,4" />

                <!-- PAINT & RETOUCH TOOLS -->
                <TextBlock Text="Paint &amp; Retouch" FontWeight="SemiBold" 
                           Foreground="{DynamicResource Theme.MutedForegroundBrush}" 
                           HorizontalAlignment="Center" 
                           Margin="0,4,0,6" FontSize="9" />
                
                <RadioButton GroupName="EditorTools" 
                             Style="{StaticResource StrategyToolButton}"
                             Command="{Binding OpenToolTabCommand}" 
                             CommandParameter="{x:Static models:EditorTool.Retouch}"
                             ToolTip="Retouch &amp; Brush (B)"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Retouch}">
                    <Path Data="{StaticResource RetouchIcon}" 
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          Stretch="Uniform" 
                          Width="24" Height="24" />
                </RadioButton>

                <RadioButton GroupName="EditorTools" 
                             Style="{StaticResource StrategyToolButton}"
                             Command="{Binding OpenToolTabCommand}" 
