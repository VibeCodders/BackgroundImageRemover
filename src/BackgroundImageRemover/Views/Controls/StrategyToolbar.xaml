<UserControl x:Class="BackgroundImageRemover.Views.Controls.StrategyToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tools="clr-namespace:BackgroundImageRemover.ViewModels.Tools"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="60">
    <UserControl.Resources>
        <Style x:Key="StrategyToolButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="PreviewMouseUp" Handler="ToolButton_PreviewMouseUp" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Theme.AccentBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.AccentForeground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One row per tool/strategy: icon resolved from IconResourceKey, IsChecked driven by
             IToolDefinition.IsActive via the shared converter (see ToolButton_PreviewMouseUp in
             the code-behind for how a click actually changes the active tool/strategy). -->
        <DataTemplate x:Key="ToolButtonTemplate" DataType="{x:Type tools:IToolDefinition}">
            <RadioButton GroupName="EditorTools"
                         Style="{StaticResource StrategyToolButton}"
                         Tag="{Binding}"
                         ToolTip="{Binding ToolTip}">
                <RadioButton.IsChecked>
                    <MultiBinding Converter="{StaticResource ToolDefinitionCheckedConverter}" Mode="OneWay">
                        <Binding />
                        <Binding Path="DataContext.ActiveTool" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        <Binding Path="DataContext.SelectedStrategy" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                </RadioButton.IsChecked>
                <Path Data="{Binding IconResourceKey, Converter={StaticResource ResourceKeyToGeometryConverter}}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Stretch="Uniform"
                      Width="24" Height="24" />
            </RadioButton>
        </DataTemplate>

        <!-- One category: header label + the wrapping row of tool icons. -->
        <DataTemplate x:Key="ToolCategoryTemplate" DataType="{x:Type tools:ToolCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.MutedForegroundBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,6" FontSize="9" />
                <ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource ToolButtonTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Separator Background="{DynamicResource Theme.BorderBrush}" Margin="0,4" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource Theme.BarBackground}"
            BorderBrush="{DynamicResource Theme.BorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Tools" FontWeight="Bold"
                           Foreground="{DynamicResource Theme.ForegroundBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,2" FontSize="10" />
                <TextBlock Text="Click to select · middle-click to open" FontStyle="Italic"
                           Foreground="{DynamicResource Theme.MutedForegroundBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="4,0,4,12" FontSize="8" />

                <!-- The whole palette: grow it by registering another IToolDefinition in
                     App.xaml.cs, nothing here needs to change. -->
                <ItemsControl ItemsSource="{Binding ToolCategories}" ItemTemplate="{StaticResource ToolCategoryTemplate}" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
