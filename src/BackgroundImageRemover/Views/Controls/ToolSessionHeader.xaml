<UserControl x:Class="BackgroundImageRemover.Views.Controls.ToolSessionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="48" d:DesignWidth="1200">
    <Border Background="{DynamicResource Theme.BarBackground}" Padding="12,8" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,0,1"
            TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
        <DockPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <Border Background="{Binding Accent, RelativeSource={RelativeSource AncestorType=UserControl}}" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Badge, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="White" FontWeight="Bold" FontSize="11" />
                </Border>
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Theme.ForegroundBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="✕ Cancel (Esc)" Command="{Binding CancelCommand}" Padding="12,6" Margin="0,0,8,0"
                        Background="{DynamicResource Theme.PanelBackground}" Foreground="{DynamicResource Theme.MutedForegroundBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" />
                <Button Content="✓ Apply (Enter)" Command="{Binding ApplyCommand}" Padding="16,6"
                        Background="{Binding Accent, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontWeight="Bold" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
