<UserControl x:Class="BackgroundImageRemover.Views.Controls.UncropCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             ClipToBounds="True"
             d:DesignHeight="400" d:DesignWidth="400">
    <UserControl.Resources>
        <Style x:Key="UncropHandleStyle" TargetType="Thumb">
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="DodgerBlue" Stroke="White" StrokeThickness="1.5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Hatched tint over the newly-added (not-yet-filled) canvas area, distinct from the
             original image content pinned on top of it. -->
        <VisualBrush x:Key="UncropNewAreaBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <VisualBrush.Visual>
                <Grid Width="16" Height="16">
                    <Rectangle Fill="#FF3A3A3A" />
                    <Path Data="M0,16 L16,0" Stroke="#FF565656" StrokeThickness="1" />
                </Grid>
            </VisualBrush.Visual>
        </VisualBrush>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Background="#FF1E1E1E"
          MouseWheel="RootGrid_MouseWheel"
          MouseDown="RootGrid_MouseDown"
          MouseMove="RootGrid_MouseMove"
          MouseUp="RootGrid_MouseUp"
          MouseLeave="RootGrid_MouseLeave">
        <Grid x:Name="ZoomPanHost">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PanTranslate" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Canvas x:Name="OverlayCanvas" Background="Transparent" SizeChanged="OverlayCanvas_SizeChanged" />
        </Grid>
    </Grid>
</UserControl>
