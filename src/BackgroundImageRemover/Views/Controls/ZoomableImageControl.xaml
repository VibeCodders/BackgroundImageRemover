<UserControl x:Class="BackgroundImageRemover.Views.Controls.ZoomableImageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             ClipToBounds="True"
             d:DesignHeight="400" d:DesignWidth="400">
    <Grid x:Name="RootGrid"
          Focusable="True"
          KeyDown="RootGrid_KeyDown"
          MouseWheel="RootGrid_MouseWheel"
          MouseDown="RootGrid_MouseDown"
          MouseMove="RootGrid_MouseMove"
          MouseUp="RootGrid_MouseUp"
          MouseLeave="RootGrid_MouseLeave">
        <Grid.Background>
            <!-- Fully opaque transparency checkerboard: white + light-gray tiles, so it renders
                 the same regardless of the window theme. -->
            <VisualBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                <VisualBrush.Visual>
                    <Grid Width="16" Height="16">
                        <Rectangle Width="8" Height="8" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Rectangle Width="8" Height="8" Fill="#FFE0E0E0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <Rectangle Width="8" Height="8" Fill="#FFE0E0E0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <Rectangle Width="8" Height="8" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.Background>

        <Grid x:Name="ZoomPanHost">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PanTranslate" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="ImageHost" Stretch="Uniform"
                   Source="{Binding ImageSource, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>

        <!-- Zoom HUD: outside the zoom/pan transform so it stays fixed, showing the current
             zoom relative to fit plus quick Fit (100%) and 1:1 (actual pixels) buttons. -->
        <Border x:Name="ZoomHud"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,10,10" Padding="6,3"
                Background="#DDFFFFFF" BorderBrush="#99BBBBBB" BorderThickness="1" CornerRadius="4"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ZoomPercentLabel" Text="100%" VerticalAlignment="Center" FontSize="11"
                           Foreground="#FF444444" Margin="0,0,8,0" MinWidth="42" TextAlignment="Right"
                           ToolTip="Zoom relative to the fit-to-window size" />
                <Button x:Name="ZoomFitButton" Content="Fit" Click="ZoomFit_Click" Padding="7,1" FontSize="11"
                        Cursor="Hand" Margin="0,0,2,0" ToolTip="Fit the image to the window (middle double-click)" />
                <Button x:Name="ZoomActualButton" Content="1:1" Click="ZoomActual_Click" Padding="7,1" FontSize="11"
                        Cursor="Hand" ToolTip="Show the image at actual pixel size" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
