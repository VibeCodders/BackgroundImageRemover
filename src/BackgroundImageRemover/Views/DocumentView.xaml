<UserControl x:Class="BackgroundImageRemover.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1300"
             AllowDrop="True" Drop="DocumentView_Drop" DragOver="DocumentView_DragOver">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="StrategyKindValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:StrategyKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Open image" Command="{Binding OpenFileCommand}" Padding="8,2"
                    ToolTip="Open an image into this tab" />
            <Separator />
            <Button Content="Undo" Command="{Binding UndoCommand}" Padding="8,2" />
            <Button Content="Redo" Command="{Binding RedoCommand}" Padding="8,2" />
            <Separator />
            <Button Content="Save" Command="{Binding SaveProjectCommand}" Padding="8,2"
                    ToolTip="Ctrl+S — save the project (.ibrproj) so you can reopen and continue later" />
            <Menu VerticalAlignment="Center">
                <MenuItem Header="Export PNG...">
                    <MenuItem Header="With crop" Command="{Binding ExportCroppedCommand}"
                              ToolTip="Trim transparent borders around the subject" />
                    <MenuItem Header="Without crop" Command="{Binding ExportCommand}"
                              ToolTip="Export at the original image size" />
                </MenuItem>
            </Menu>
            <Separator />
            <Button Content="Batch..." Command="{Binding BatchCommand}" Padding="8,2" />
            <TextBlock Text="{Binding BatchStatus}" VerticalAlignment="Center" Margin="8,0"
                       Visibility="{Binding IsBatchRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
        </ToolBar>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CutoutStatus}"
                               Foreground="#FF1E7A33"
                               FontWeight="SemiBold"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsCutout, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusMessage}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Strategy + refinement controls -->
        <Border DockPanel.Dock="Right" Width="320" Padding="12" BorderBrush="#FFCCCCCC" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Strategy" FontWeight="Bold" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding Source={StaticResource StrategyKindValues}}"
                          SelectedItem="{Binding SelectedStrategy}"
                          Margin="0,0,0,16" />

                <!-- Chroma Key options -->
                <StackPanel Visibility="{Binding SelectedStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ChromaKey}">
                    <TextBlock Text="Detected background color:" />
                    <Rectangle Height="24" Fill="{Binding ChromaKey.DetectedColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" Margin="0,4,0,12" />
                    <TextBlock Text="Tolerance" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding ChromaKey.Tolerance}" TickFrequency="5" />
                    <CheckBox Content="Spill suppression" IsChecked="{Binding ChromaKey.SpillSuppression}" Margin="0,8,0,0" />
                </StackPanel>

                <!-- GrabCut options -->
                <StackPanel Visibility="{Binding SelectedStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=GrabCut}">
                    <TextBlock Text="Draw a rectangle around the subject on the left image." TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding GrabCut.HasValidRect, StringFormat='Rectangle selected: {0}'}" Margin="0,0,0,8" />

                    <TextBlock Text="Refine with scribbles (optional):" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <UniformGrid Columns="2" Margin="0,0,0,4">
                        <RadioButton Content="Foreground" GroupName="ScribbleMode" Margin="0,0,4,4"
                                     IsChecked="{Binding OriginalMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ScribbleForeground, Mode=OneWay}"
                                     Command="{Binding SetOriginalScribbleModeCommand}" CommandParameter="{x:Static models:InteractionMode.ScribbleForeground}" />
                        <RadioButton Content="Background" GroupName="ScribbleMode" Margin="4,0,0,4"
                                     IsChecked="{Binding OriginalMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ScribbleBackground, Mode=OneWay}"
                                     Command="{Binding SetOriginalScribbleModeCommand}" CommandParameter="{x:Static models:InteractionMode.ScribbleBackground}" />
                    </UniformGrid>
                    <Button Content="Refine preview with scribbles" Command="{Binding RefineGrabCutPreviewCommand}"
                            Visibility="{Binding GrabCut.HasScribbles, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!-- ONNX options -->
                <StackPanel Visibility="{Binding SelectedStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Onnx}">
                    <TextBlock Text="Model" />
                    <ComboBox ItemsSource="{Binding Onnx.AvailableModels}" SelectedItem="{Binding Onnx.SelectedModel}" Margin="0,0,0,8" />
                    <StackPanel Visibility="{Binding Onnx.IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Downloading model..." Margin="0,0,0,4" />
                        <ProgressBar Height="16" Minimum="0" Maximum="1" Value="{Binding Onnx.DownloadFraction, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Onnx.ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                               Visibility="{Binding Onnx.ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                    <Button Content="Retry download" Command="{Binding RetryOnnxDownloadCommand}"
                            Visibility="{Binding Onnx.ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,4,0,8" />
                    <TextBlock Text="Edge feather" Margin="0,8,0,0" />
                    <Slider Minimum="0" Maximum="15" Value="{Binding Onnx.FeatherPixels}" />
                    <CheckBox Content="Alpha matting refinement (slower)" IsChecked="{Binding Onnx.EnableAlphaMatting}" Margin="0,8,0,0" />
                    <CheckBox Content="Use GPU (DirectML)" IsChecked="{Binding UseGpuForOnnx}" Margin="0,8,0,0" />
                </StackPanel>

                <!-- SAM options -->
                <StackPanel Visibility="{Binding SelectedStrategy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Sam}">
                    <TextBlock Text="Click on the subject in the Original image." TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Sam.HasClickedPoint, StringFormat='Point selected: {0}'}" Margin="0,0,0,8" />
                    <StackPanel Visibility="{Binding Sam.IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Downloading SAM model..." Margin="0,0,0,4" />
                        <ProgressBar Height="16" Minimum="0" Maximum="1" Value="{Binding Sam.DownloadFraction, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Sam.ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                               Visibility="{Binding Sam.ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                    <Button Content="Retry download" Command="{Binding RetrySamDownloadCommand}"
                            Visibility="{Binding Sam.ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,4,0,8" />
                </StackPanel>

                <Separator Margin="0,16"/>

                <!-- Result refinement tools -->
                <TextBlock Text="Retouch result" FontWeight="Bold" Margin="0,0,0,8" />
                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <Button Content="None" Command="{Binding SetResultModeCommand}" CommandParameter="{x:Static models:InteractionMode.None}" Margin="0,0,2,0" />
                    <Button Content="Brush" Command="{Binding SetResultModeCommand}" CommandParameter="{x:Static models:InteractionMode.Brush}" Margin="2,0" />
                    <Button Content="Wand" Command="{Binding SetResultModeCommand}" CommandParameter="{x:Static models:InteractionMode.MagicWand}" Margin="2,0,0,0" />
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <RadioButton Content="Restore" GroupName="BrushMode" Margin="0,0,4,0"
                                 IsChecked="{Binding BrushMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Restore}" />
                    <RadioButton Content="Erase" GroupName="BrushMode" Margin="4,0,0,0"
                                 IsChecked="{Binding BrushMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Erase}" />
                </UniformGrid>

                <StackPanel Visibility="{Binding ResultMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Brush}">
                    <TextBlock Text="Brush size" />
                    <Slider Minimum="2" Maximum="120" Value="{Binding BrushRadius}" />
                    <TextBlock Text="Brush hardness" />
                    <Slider Minimum="0" Maximum="0.95" Value="{Binding BrushHardness}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ResultMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=MagicWand}">
                    <TextBlock Text="Wand tolerance" />
                    <Slider Minimum="1" Maximum="100" Value="{Binding MagicWandTolerance}" />
                </StackPanel>

                <CheckBox Content="Compare before/after" IsChecked="{Binding IsCompareMode}" Margin="0,8,0,16" />

                <Separator Margin="0,0,0,16"/>

                <!-- Export options -->
                <TextBlock Text="Export background" FontWeight="Bold" Margin="0,0,0,8" />
                <RadioButton Content="Transparent" GroupName="ExportBg" Margin="0,0,0,4"
                             IsChecked="{Binding ExportBackgroundMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Transparent}" />
                <RadioButton Content="Solid color" GroupName="ExportBg" Margin="0,0,0,4"
                             IsChecked="{Binding ExportBackgroundMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SolidColor}" />
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding ExportBackgroundMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=SolidColor}"
                            Margin="16,0,0,8">
                    <Rectangle Width="24" Height="24" Fill="{Binding ExportSolidColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" />
                    <Button x:Name="ChooseColorButton" Content="Choose..." Margin="8,0,0,0"
                            Click="ChooseColorButton_Click" />
                    <Popup IsOpen="{Binding IsColorPickerOpen}" PlacementTarget="{Binding ElementName=ChooseColorButton}"
                           StaysOpen="False" AllowsTransparency="True" Placement="Right">
                        <Border Background="White" BorderBrush="Gray" BorderThickness="1">
                            <controls:SimpleColorPickerControl SelectedColor="{Binding ExportSolidColor}" />
                        </Border>
                    </Popup>
                </StackPanel>
                <RadioButton Content="Image" GroupName="ExportBg" Margin="0,0,0,4"
                             IsChecked="{Binding ExportBackgroundMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Image}" />
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding ExportBackgroundMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Image}"
                            Margin="16,0,0,8">
                    <Button Content="Choose image..." Command="{Binding PickBackgroundImageCommand}" />
                </StackPanel>

                <ProgressBar Height="18" IsIndeterminate="True" Margin="0,20,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="{Binding BusyMessage}" Margin="0,4,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Image panes -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Original (draw rect / scribbles / SAM click here)" FontWeight="Bold" Margin="0,0,0,4" />
                <controls:ImagePreviewControl x:Name="OriginalPreview"
                                               ImageSource="{Binding PreviewBitmap}"
                                               Mode="{Binding OriginalMode}"
                                               RectSelected="OriginalPreview_RectSelected"
                                               StrokeStart="OriginalPreview_StrokeStart"
                                               StrokeMove="OriginalPreview_StrokeMove"
                                               StrokeEnd="OriginalPreview_StrokeEnd"
                                               SamPointClicked="OriginalPreview_SamPointClicked" />
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Result" FontWeight="Bold" Margin="0,0,0,4" />

                <controls:CompareImageControl BeforeSource="{Binding PreviewBitmap}" AfterSource="{Binding ResultBitmap}"
                                               DividerPosition="{Binding CompareDividerPosition}"
                                               Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVisibilityConverter}}" />

                <controls:ImagePreviewControl x:Name="ResultEditPreview"
                                               ImageSource="{Binding ResultBitmap}"
                                               Mode="{Binding ResultMode}"
                                               BrushRadius="{Binding BrushRadius}"
                                               StrokeStart="ResultEditPreview_StrokeStart"
                                               StrokeMove="ResultEditPreview_StrokeMove"
                                               StrokeEnd="ResultEditPreview_StrokeEnd"
                                               WandClicked="ResultEditPreview_WandClicked"
                                               Visibility="{Binding IsCompareMode, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
