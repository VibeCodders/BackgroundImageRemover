<UserControl x:Class="BackgroundImageRemover.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             xmlns:panels="clr-namespace:BackgroundImageRemover.Views.Panels"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1300"
             AllowDrop="True" Drop="DocumentView_Drop" DragOver="DocumentView_DragOver">
    <UserControl.Resources>
        <Style x:Key="ToolTabActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE0E7FF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF6366F1" />
                                <Setter Property="Foreground" Value="#FF4338CA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFC7D2FE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE0E7FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFC7D2FE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Top Main Tools Ribbon / Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Theme.BarBackground}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <!-- Quick File Actions -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Content="Open image" Command="{Binding OpenFileCommand}" Padding="8,4" Margin="0,0,4,0"
                            ToolTip="Open an image file into this tab" />
                    <Button Content="Paste" Command="{Binding PasteFromClipboardCommand}" Padding="8,4" Margin="0,0,4,0"
                            ToolTip="Ctrl+V — paste image from clipboard" />
                    <Button Content="Copy" Command="{Binding CopyToClipboardCommand}" Padding="8,4" Margin="0,0,4,0"
                            ToolTip="Ctrl+Shift+C — copy the cutout to the clipboard" />
                    <Button Content="Save" Command="{Binding SaveProjectCommand}" Padding="8,4" Margin="0,0,4,0"
                            ToolTip="Ctrl+S — save project (.ibrproj)" />
                    <Menu VerticalAlignment="Center" Margin="0,0,4,0">
                        <MenuItem Header="Export PNG...">
                            <MenuItem Header="With crop" Command="{Binding ExportCroppedCommand}"
                                      ToolTip="Trim transparent borders around the subject" />
                            <MenuItem Header="Without crop" Command="{Binding ExportCommand}"
                                      ToolTip="Export at the original image size" />
                        </MenuItem>
                        <MenuItem Header="Export JPG...">
                            <MenuItem Header="With crop" Command="{Binding ExportJpgCroppedCommand}"
                                      ToolTip="Trim transparent borders, then composite onto the chosen background" />
                            <MenuItem Header="Without crop" Command="{Binding ExportJpgCommand}"
                                      ToolTip="Composite the cutout onto the chosen background at the original image size" />
                        </MenuItem>
                    </Menu>
                    <Separator Margin="4,0" />
                    <Button Content="Undo" Command="{Binding UndoCommand}" Padding="8,4" Margin="0,0,2,0" />
                    <Button Content="Redo" Command="{Binding RedoCommand}" Padding="8,4" Margin="0,0,4,0" />
                    <Separator Margin="4,0" />
                    <ToggleButton Content="◫ Split View" IsChecked="{Binding IsSplitViewEnabled}" Padding="8,4" Margin="0,0,4,0"
                                  ToolTip="Toggle side-by-side comparison view (Original on left, Result on right)" />
                    <ToggleButton Content="◑ Compare" IsChecked="{Binding IsCompareMode}" Padding="8,4" Margin="0,0,4,0"
                                  ToolTip="Toggle the before/after slider comparison (drag the divider to scrub)" />
                    <Separator Margin="4,0" />
                    <Button Content="Batch..." Command="{Binding BatchCommand}" Padding="8,4" />
                    <Button Content="✕ Cancel batch" Command="{Binding CancelBatchCommand}" Padding="8,4"
                            Foreground="#FFB91C1C" FontWeight="SemiBold"
                            Visibility="{Binding IsBatchRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Stop the running batch after the current file" />
                </StackPanel>

                <!-- Tool Openers (Right) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ToolsMenuButton" Content="🛠 Tools ▾" Padding="12,6" Margin="0,0,4,0"
                            Click="ToolsMenuButton_Click" Cursor="Hand" FontWeight="SemiBold" />
                    <Popup x:Name="ToolsPopup" PlacementTarget="{Binding ElementName=ToolsMenuButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="6"
                                Padding="6" MinWidth="240" MaxHeight="520" Margin="0,4,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Button Content="✂  Background Remover" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.RemoveBackground}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="⤢  Uncrop / Expand" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Uncrop}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="🖌  Retouch &amp; Brush" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Retouch}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="✨  Adjustments" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Adjustments}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="🎨  Filters" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Filters}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="↻  Transform" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Transform}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="🖼  Compose" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Compose}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="▣  Frame" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Frame}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="✎  Text" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Text}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="✂  Crop" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Crop}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="⤡  Resize" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Resize}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="▦  Mosaic" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Mosaic}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="🔲  Overlay" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Overlay}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="📊  Levels" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Levels}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="🩹  Heal" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Heal}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="✋  Liquify" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Liquify}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="🔲  Perspective" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Perspective}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="✨  FX" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.Fx}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                    <Button Content="📐  Tilt-Shift" Command="{Binding OpenToolTabCommand}" CommandParameter="{x:Static models:EditorTool.TiltShift}" IsEnabled="{Binding IsImageLoaded}" Style="{StaticResource PopupToolButton}" Click="ToolButton_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Undo/Redo History Panel -->
        <Border DockPanel.Dock="Left" Width="220" Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsImageLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource Theme.PanelHeaderBackground}" Padding="10,8" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="History" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundBrush}" />
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="No edits yet" Foreground="{DynamicResource Theme.MutedForegroundBrush}" FontStyle="Italic" Margin="10,8"
                           Visibility="{Binding HasEditSteps, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <ListBox ItemsSource="{Binding EditSteps}" SelectedItem="{Binding SelectedEditStep}"
                         BorderThickness="0" Background="Transparent"
                         ToolTip="Click a step to jump the document back/forward to that state"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="StepText" Text="{Binding Name}" Foreground="{DynamicResource Theme.ForegroundBrush}" FontSize="12"
                                       Margin="2,3" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUndone}" Value="True">
                                    <Setter TargetName="StepText" Property="Foreground" Value="#FFAAAAAA" />
                                    <Setter TargetName="StepText" Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Active Tool Session Modal Banner (when a tool tab is currently open for this doc) -->
        <Border DockPanel.Dock="Top" Background="#FFF3E8FF" BorderBrush="#FFD8B4FE" BorderThickness="0,0,0,1" Padding="12,6"
                Visibility="{Binding HasActiveToolSession, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <TextBlock Text="⚡ Modal Tool Session is currently active for this document." FontWeight="SemiBold" Foreground="#FF6B21A8" VerticalAlignment="Center" />
                <Button Content="Return to Tool Tab →" Command="{Binding OpenToolTabCommand}" CommandParameter="{Binding ActiveTool}"
                        HorizontalAlignment="Right" Padding="10,3" Background="#FF7E22CE" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Theme.BarBackground}" Foreground="{DynamicResource Theme.ForegroundBrush}">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CutoutStatus}"
                               Foreground="#FF1E7A33"
                               FontWeight="SemiBold"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsCutout, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusMessage}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CursorPositionLabel" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="#FF555555" FontSize="11" MinWidth="72"
                               ToolTip="Image pixel coordinates under the cursor" />
                    <TextBlock Text="{Binding ImageDimensions}" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="#FF555555" FontSize="11" ToolTip="Current image dimensions in pixels" />
                    <Button Content="📂 Open folder" Command="{Binding RevealLastExportInExplorerCommand}"
                            Padding="8,2" Margin="0,0,12,0" FontSize="11" Cursor="Hand"
                            ToolTip="Open the folder of the last exported file in Explorer"
                            Visibility="{Binding HasLastExport, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressBar IsIndeterminate="True" Width="100" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BusyMessage}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#FF555555" />
                    </StackPanel>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Dynamic Contextual Side Panel (Only visible when a tool is active) -->
        <Border DockPanel.Dock="Right" Width="330" Padding="14" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource Theme.PanelBackground}"
                Visibility="{Binding ActiveTool, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=RemoveBackground|Uncrop|Retouch|Adjustments}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- PANEL 1: REMOVE BACKGROUND -->
                    <panels:BackgroundRemoverPanel
                        Visibility="{Binding ActiveTool, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=RemoveBackground}" />

                    <!-- PANEL 2: UNCROP / CANVAS EXPAND -->
                    <panels:UncropPanel
                        Visibility="{Binding ActiveTool, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Uncrop}" />

                    <!-- PANEL 3: RETOUCH & BRUSH -->
                    <panels:RetouchPanel
                        Visibility="{Binding ActiveTool, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Retouch}" />

                    <!-- PANEL 4: VISUAL ADJUSTMENTS -->
                    <panels:AdjustmentsPanel
                        Visibility="{Binding ActiveTool, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Adjustments}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Central Work Area -->
        <Grid>
            <!-- Empty State / Open Image Drop Prompt -->
            <Grid Visibility="{Binding IsImageLoaded, Converter={StaticResource InverseBoolToVisibilityConverter}}" Background="{DynamicResource Theme.PanelBackground}">
                <Border BorderBrush="#FFCCCCCC" BorderThickness="2" CornerRadius="12" Margin="40" Padding="30"
                        Background="White" MaxWidth="600" MaxHeight="380" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#FFE6F2FB" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🖼" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Welcome to Image Editor" FontSize="20" FontWeight="Bold" Foreground="#FF222222" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Open an image to start editing, removing backgrounds, outpainting, or retouching"
                                   FontSize="13" Foreground="#FF666666" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="📁 Open Image..." Command="{Binding OpenFileCommand}"
                                    Padding="16,8" Height="36" FontWeight="SemiBold" Background="#FF0078D7" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0" />
                            <Button Content="📋 Paste Image" Command="{Binding PasteFromClipboardCommand}"
                                    Padding="16,8" Height="36" FontWeight="SemiBold" Background="#FFF0F0F0" Foreground="#FF333333" BorderBrush="#FFCCCCCC" BorderThickness="1" Cursor="Hand" />
                        </StackPanel>
                        <TextBlock Text="Or drag &amp; drop an image anywhere into this window" FontSize="11" Foreground="#FF888888" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Editor Work Area (when image is loaded) -->
            <Grid Visibility="{Binding IsImageLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- View when UNPAINT/UNCROP tool is active -->
                <Grid Visibility="{Binding ActiveTool, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Uncrop}" Margin="8">
                    <controls:UncropCanvasControl ImageSource="{Binding PreviewBitmap}"
                                                  ImagePadding="{Binding UncropOptions.Padding, Mode=TwoWay}" />
                </Grid>

                <!-- When ActiveTool is not Uncrop: -->
                <Grid Visibility="{Binding ActiveTool, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=None|RemoveBackground|Retouch|Adjustments}">
                    <!-- Single View (Default: Split View OFF) -->
                    <Grid Margin="8" Visibility="{Binding IsSplitViewEnabled, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <controls:ImagePreviewControl x:Name="SinglePreview"
                                                       ImageSource="{Binding DisplayBitmap}"
                                                       Mode="{Binding ResultMode}"
                                                       BrushRadius="{Binding BrushRadius}"
                                                       StrokeStart="ResultEditPreview_StrokeStart"
                                                       StrokeMove="ResultEditPreview_StrokeMove"
                                                       StrokeEnd="ResultEditPreview_StrokeEnd"
                                                       WandClicked="ResultEditPreview_WandClicked"
                                                       Visibility="{Binding IsCompareMode, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                        <controls:CompareImageControl BeforeSource="{Binding PreviewBitmap}"
                                                       AfterSource="{Binding ResultBitmap}"
                                                       DividerPosition="{Binding CompareDividerPosition}"
                                                       Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <!-- Split View (When IsSplitViewEnabled is true) -->
                    <Grid Visibility="{Binding IsSplitViewEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Margin="8">
                            <TextBlock DockPanel.Dock="Top" Text="Original (draw rect / scribbles / SAM click)" FontWeight="Bold" Margin="0,0,0,4" />
                            <controls:ImagePreviewControl x:Name="OriginalPreview"
                                                           ImageSource="{Binding PreviewBitmap}"
                                                           ScribbleOverlay="{Binding ScribbleOverlay}"
                                                           Mode="{Binding OriginalMode}"
                                                           RectSelected="OriginalPreview_RectSelected"
                                                           StrokeStart="OriginalPreview_StrokeStart"
                                                           StrokeMove="OriginalPreview_StrokeMove"
                                                           StrokeEnd="OriginalPreview_StrokeEnd"
                                                           SamPointClicked="OriginalPreview_SamPointClicked"
                                                           WandClicked="OriginalPreview_WandClicked" />
                        </DockPanel>

                        <DockPanel Grid.Column="1" Margin="8">
                            <TextBlock DockPanel.Dock="Top" Text="Result" FontWeight="Bold" Margin="0,0,0,4" />

                            <controls:CompareImageControl BeforeSource="{Binding PreviewBitmap}" AfterSource="{Binding ResultBitmap}"
                                                           DividerPosition="{Binding CompareDividerPosition}"
                                                           Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <controls:ImagePreviewControl x:Name="ResultEditPreview"
                                                           ImageSource="{Binding ResultBitmap}"
                                                           Mode="{Binding ResultMode}"
                                                           BrushRadius="{Binding BrushRadius}"
                                                           StrokeStart="ResultEditPreview_StrokeStart"
                                                           StrokeMove="ResultEditPreview_StrokeMove"
                                                           StrokeEnd="ResultEditPreview_StrokeEnd"
                                                           WandClicked="ResultEditPreview_WandClicked"
                                                           Visibility="{Binding IsCompareMode, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
