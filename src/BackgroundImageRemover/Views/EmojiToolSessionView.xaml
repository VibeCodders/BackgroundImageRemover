<UserControl x:Class="BackgroundImageRemover.Views.EmojiToolSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:services="clr-namespace:BackgroundImageRemover.Services.Editing"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="EmojiKindValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="services:EmojiOverlayService+EmojiKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="TextAnchorValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TextAnchor" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
        <controls:ToolSessionHeader Badge="🎉 EMOJI" Accent="#FFF59E0B" />

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Theme.BarBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <StatusBarItem><TextBlock Text="{Binding StatusMessage}" /></StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Right" Width="300" Padding="14" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource Theme.PanelBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Emoji Overlay" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource Theme.ForegroundBrush}" />

                    <TextBlock Text="Choose a decorative emoji and position it on the image." Margin="0,0,0,12"
                               Foreground="{DynamicResource Theme.MutedForegroundBrush}" TextWrapping="Wrap" />

                    <TextBlock Text="Emoji" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Source={StaticResource EmojiKindValues}}" SelectedItem="{Binding SelectedEmoji}" Margin="0,0,0,12" />

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Size" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding EmojiSize, StringFormat='{}{0:0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="8" Maximum="200" Value="{Binding EmojiSize}" TickFrequency="4" IsSnapToTickEnabled="True" Margin="0,2,0,8" />

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Opacity" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding Opacity, StringFormat='{}{0:P0}'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Opacity}" SmallChange="0.05" Margin="0,2,0,8" />

                    <TextBlock Text="Color" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <controls:SimpleColorPickerControl SelectedColor="{Binding EmojiColor}" />

                    <Separator Margin="0,8,0,0" />
                    <CheckBox Content="Scatter mode (random positions)" IsChecked="{Binding ScatterMode}" Margin="0,0,0,8" />

                    <DockPanel Margin="0,4,0,0" Visibility="{Binding ScatterMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="Position" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource TextAnchorValues}}" SelectedItem="{Binding Anchor}" Margin="0,0,0,8" />
                    </DockPanel>

                    <DockPanel Margin="0,4,0,0" Visibility="{Binding ScatterMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="Margin" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding Margin, StringFormat='{}{0:0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="100" Value="{Binding Margin}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,16"
                            Visibility="{Binding ScatterMode, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                    <Button Content="↺ Reset" Command="{Binding ResetCommand}" Height="30" Background="{DynamicResource Theme.PanelHeaderBackground}" Foreground="{DynamicResource Theme.ForegroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Margin="8">
            <Border BorderBrush="#FF3A3A3A" BorderThickness="1">
                <controls:ZoomableImageControl ImageSource="{Binding ResultBitmap}" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
