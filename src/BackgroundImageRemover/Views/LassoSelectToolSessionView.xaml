<UserControl x:Class="BackgroundImageRemover.Views.LassoSelectToolSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource Theme.BarBackground}" Padding="12,8" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Background="#FF0EA5E9" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="◈ LASSO" Foreground="White" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Theme.ForegroundBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="✕ Cancel (Esc)" Command="{Binding CancelCommand}" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource Theme.PanelBackground}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" />
                    <Button Content="✓ Apply (Enter)" Command="{Binding ApplyCommand}" Padding="16,6" Background="#FF0EA5E9" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Theme.BarBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <StatusBarItem><TextBlock Text="{Binding StatusMessage}" /></StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Right" Width="280" Padding="14" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource Theme.PanelBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Lasso Select" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource Theme.ForegroundBrush}" />
                    <TextBlock Text="Draw a freehand outline on the left. The area inside becomes the cutout -- toggle Invert to keep the outside instead."
                               FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <CheckBox Content="Invert (keep outside)" IsChecked="{Binding InvertSelection}" Margin="0,0,0,12" />

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Edge feather" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding FeatherPixels}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="40" Value="{Binding FeatherPixels}" Margin="0,2,0,12" />

                    <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Drag to draw a freehand selection" FontWeight="Bold" Margin="0,0,0,4" />
                <controls:ImagePreviewControl x:Name="LassoPreview"
                                               ImageSource="{Binding SourceBitmap}"
                                               Mode="{x:Static models:InteractionMode.Lasso}"
                                               StrokeStart="LassoPreview_StrokeStart"
                                               StrokeMove="LassoPreview_StrokeMove"
                                               StrokeEnd="LassoPreview_StrokeEnd" />
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Result" FontWeight="Bold" Margin="0,0,0,4" />
                <Border BorderBrush="#FF3A3A3A" BorderThickness="1">
                    <controls:ZoomableImageControl ImageSource="{Binding ResultBitmap}" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
