<UserControl x:Class="BackgroundImageRemover.Views.MosaicToolSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="MosaicModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:MosaicMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
        </Style>
    </UserControl.Resources>
    <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource Theme.BarBackground}" Padding="12,8" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Background="#FFEA580C" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="▦ MOSAIC" Foreground="White" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Theme.ForegroundBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="✕ Cancel (Esc)" Command="{Binding CancelCommand}" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource Theme.PanelBackground}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" />
                    <Button Content="✓ Apply (Enter)" Command="{Binding ApplyCommand}" Padding="16,6" Background="#FFEA580C" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Theme.BarBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <StatusBarItem><TextBlock Text="{Binding StatusMessage}" /></StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Right" Width="300" Padding="14" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource Theme.PanelBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Mosaic" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource Theme.ForegroundBrush}" />

                    <CheckBox Content="Paint region with brush" IsChecked="{Binding PaintMode}" Margin="0,0,0,8" />

                    <StackPanel Visibility="{Binding PaintMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Brush size" FontWeight="SemiBold" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding BrushRadius, StringFormat='{}{0:0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <Slider Minimum="2" Maximum="150" Value="{Binding BrushRadius}" Margin="0,2,0,8" />
                        <Button Content="✕ Clear painted mask" Command="{Binding ClearMaskCommand}" Margin="0,0,0,8" />
                        <TextBlock Text="Paint on the left image to mosaic just the painted area." TextWrapping="Wrap" Foreground="{DynamicResource Theme.MutedForegroundBrush}" Margin="0,0,0,12" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding PaintMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <CheckBox Content="Apply to whole image" IsChecked="{Binding WholeImage}" Margin="0,0,0,8" />
                        <TextBlock Text="Drag a rectangle on the left to mosaic just a region." TextWrapping="Wrap" Foreground="{DynamicResource Theme.MutedForegroundBrush}" Margin="0,0,0,12"
                                   Visibility="{Binding WholeImage, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    </StackPanel>

                    <TextBlock Text="Effect" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Source={StaticResource MosaicModeValues}}" SelectedItem="{Binding Mode}" Margin="0,0,0,12" />

                    <CheckBox Content="Mosaic everything outside selection" IsChecked="{Binding InvertRegion}" Margin="0,0,0,8" />

                    <StackPanel Visibility="{Binding Mode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Pixelate|Crystallize}">
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Cell size" FontWeight="SemiBold" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding CellSize, StringFormat='{}{0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <Slider Minimum="2" Maximum="64" Value="{Binding CellSize}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,12" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding Mode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Blur|Median}">
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Blur radius" FontWeight="SemiBold" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding BlurRadius, StringFormat='{}{0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <Slider Minimum="1" Maximum="80" Value="{Binding BlurRadius}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,12" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding Mode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Blur}">
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Blur strength" FontWeight="SemiBold" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding Strength, StringFormat='{}{0:P0}'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <Slider Minimum="0.05" Maximum="1" Value="{Binding Strength}" Margin="0,2,0,12" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding Mode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Crystallize}">
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Crystal jitter" FontWeight="SemiBold" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding Jitter, StringFormat='{}{0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="32" Value="{Binding Jitter}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,12" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding Mode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=SolidFill}">
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <Rectangle Width="24" Height="24" Fill="{Binding FillColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" />
                            <Button x:Name="ChooseFillColorButton" Content="Choose color..." Margin="8,0,0,0" Click="ChooseFillColorButton_Click" />
                            <Popup IsOpen="{Binding IsFillColorPickerOpen}" PlacementTarget="{Binding ElementName=ChooseFillColorButton}" StaysOpen="False" AllowsTransparency="True" Placement="Right">
                                <Border Background="White" BorderBrush="Gray" BorderThickness="1">
                                    <controls:SimpleColorPickerControl SelectedColor="{Binding FillColor}" />
                                </Border>
                            </Popup>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="↺ Reset" Command="{Binding ResetCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Drag to select a region, or paint with the brush" FontWeight="Bold" Margin="0,0,0,4" />
                <controls:ImagePreviewControl x:Name="MosaicPreview"
                                               ImageSource="{Binding SourceBitmap}"
                                               Mode="{Binding PreviewMode}"
                                               BrushRadius="{Binding BrushRadius}"
                                               RectSelected="MosaicPreview_RectSelected"
                                               StrokeStart="MosaicPreview_StrokeStart"
                                               StrokeMove="MosaicPreview_StrokeMove"
                                               StrokeEnd="MosaicPreview_StrokeEnd" />
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Result" FontWeight="Bold" Margin="0,0,0,4" />
                <Border BorderBrush="#FF3A3A3A" BorderThickness="1">
                    <Image Source="{Binding ResultBitmap}" Stretch="Uniform" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
