<UserControl x:Class="BackgroundImageRemover.Views.Panels.LayersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="280">
    
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Theme.PanelHeaderBackground}" 
                Padding="10,8" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="Layers" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="AddLayerButton" Content="+" Width="24" Height="24" Margin="2,0" 
                            Click="AddLayerButton_Click" ToolTip="Add new layer" />
                    <Button x:Name="DuplicateLayerButton" Content="⧉" Width="24" Height="24" Margin="2,0" 
                            Click="DuplicateLayerButton_Click" ToolTip="Duplicate layer" />
                    <Button x:Name="DeleteLayerButton" Content="×" Width="24" Height="24" Margin="2,0" 
                            Click="DeleteLayerButton_Click" ToolTip="Delete layer" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Layers List -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Layers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ImageLayer}">
                        <Border Background="{DynamicResource Theme.PanelBackground}" 
                                BorderBrush="{DynamicResource Theme.BorderBrush}" 
                                BorderThickness="0,0,0,1" 
                                Padding="8,6"
                                Margin="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Visibility Eye -->
                                <Button Grid.Column="0" Width="20" Height="20" Margin="0,0,4,0"
                                        Background="Transparent" BorderThickness="0"
                                        Content="👁" FontSize="12"
                                        ToolTip="Toggle visibility">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Opacity" Value="0.5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                    <Setter Property="Opacity" Value="1.0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Lock -->
                                <Button Grid.Column="1" Width="20" Height="20" Margin="0,0,4,0"
                                        Background="Transparent" BorderThickness="0"
                                        Content="🔒" FontSize="12"
                                        ToolTip="Toggle lock">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Opacity" Value="0.3" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter Property="Opacity" Value="1.0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Layer Name & Thumbnail -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                                    <Border Width="32" Height="32" Background="Transparent" 
                                            BorderBrush="{DynamicResource Theme.BorderBrush}" 
                                            BorderThickness="1" Margin="0,0,6,0">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" 
                                               Width="30" Height="30" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" 
                                               Foreground="{DynamicResource Theme.ForegroundBrush}" />
                                </StackPanel>

                                <!-- Blend Mode -->
                                <ComboBox Grid.Column="3" Width="80" 
                                          SelectedItem="{Binding BlendMode}" 
                                          FontSize="11">
                                    <ComboBoxItem Content="Normal" Tag="Normal" />
                                    <ComboBoxItem Content="Multiply" Tag="Multiply" />
                                    <ComboBoxItem Content="Screen" Tag="Screen" />
                                    <ComboBoxItem Content="Overlay" Tag="Overlay" />
                                    <ComboBoxItem Content="Darken" Tag="Darken" />
                                    <ComboBoxItem Content="Lighten" Tag="Lighten" />
                                </ComboBox>

                                <!-- Opacity -->
                                <StackPanel Grid.Column="4" Width="60" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Opacity, StringFormat='{}{0:P0}'}" 
                                               FontSize="10" Foreground="{DynamicResource Theme.MutedForegroundBrush}" />
                                    <Slider Minimum="0" Maximum="1" Value="{Binding Opacity}" 
                                            Height="16" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>