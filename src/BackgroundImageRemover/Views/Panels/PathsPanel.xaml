<UserControl x:Class="BackgroundImageRemover.Views.Panels.PathsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="280">
    
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Theme.PanelHeaderBackground}" 
                Padding="10,8" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="Paths" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="AddPathButton" Content="+" Width="24" Height="24" Margin="2,0" 
                            Click="AddPathButton_Click" ToolTip="Add new path" />
                    <Button x:Name="DuplicatePathButton" Content="⧉" Width="24" Height="24" Margin="2,0" 
                            Click="DuplicatePathButton_Click" ToolTip="Duplicate path" />
                    <Button x:Name="DeletePathButton" Content="×" Width="24" Height="24" Margin="2,0" 
                            Click="DeletePathButton_Click" ToolTip="Delete path" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Paths List -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Paths}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PathObject}">
                        <Border Background="{DynamicResource Theme.PanelBackground}" 
                                BorderBrush="{DynamicResource Theme.BorderBrush}" 
                                BorderThickness="0,0,0,1" 
                                Padding="8,6"
                                Margin="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Visibility Eye -->
                                <Button Grid.Column="0" Width="20" Height="20" Margin="0,0,4,0"
                                        Background="Transparent" BorderThickness="0"
                                        Content="👁" FontSize="12"
                                        ToolTip="Toggle visibility">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Opacity" Value="0.5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                    <Setter Property="Opacity" Value="1.0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Lock -->
                                <Button Grid.Column="1" Width="20" Height="20" Margin="0,0,4,0"
                                        Background="Transparent" BorderThickness="0"
                                        Content="🔒" FontSize="12"
                                        ToolTip="Toggle lock">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Opacity" Value="0.3" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter Property="Opacity" Value="1.0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Path Name -->
                                <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" 
                                           Foreground="{DynamicResource Theme.ForegroundBrush}" />

                                <!-- Stroke/Fill Preview -->
                                <Border Grid.Column="3" Width="24" Height="24" Background="Transparent" 
                                        BorderBrush="{DynamicResource Theme.BorderBrush}" 
                                        BorderThickness="1" Margin="8,0,0,0">
                                    <Path Stroke="{Binding Stroke}" StrokeThickness="2" 
                                          Fill="{Binding Fill}" 
                                          Width="20" Height="20" Stretch="Uniform">
                                        <Path.Data>
                                            <EllipseGeometry Center="10,10" RadiusX="8" RadiusY="8" />
                                        </Path.Data>
                                    </Path>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>