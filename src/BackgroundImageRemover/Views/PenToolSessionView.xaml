<UserControl x:Class="BackgroundImageRemover.Views.PenToolSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
        <controls:ToolSessionHeader Badge="✏️ PEN" Accent="#FF0EA5E9" />

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Theme.BarBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <StatusBarItem><TextBlock Text="{Binding StatusMessage}" /></StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Right" Width="300" Padding="14" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource Theme.PanelBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Pen" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource Theme.ForegroundBrush}" />

                    <TextBlock Text="Drag on the image to draw freehand." Margin="0,0,0,12"
                               Foreground="{DynamicResource Theme.MutedForegroundBrush}" TextWrapping="Wrap" />

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Size" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding PenWidth, StringFormat='{}{0:0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="1" Maximum="100" Value="{Binding PenWidth}" SmallChange="1" Margin="0,2,0,12" />

                    <controls:ColorPickerField Header="Color" SelectedColor="{Binding Color}" />

                    <Button Content="✕ Clear all strokes" Command="{Binding ClearCommand}" Height="30" Background="{DynamicResource Theme.PanelHeaderBackground}" Foreground="{DynamicResource Theme.ForegroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Margin="8">
            <controls:ImagePreviewControl x:Name="PenPreview"
                                          ImageSource="{Binding ResultBitmap}"
                                          Mode="{x:Static models:InteractionMode.Brush}"
                                          BrushRadius="{Binding PenWidth}"
                                          StrokeStart="PenPreview_StrokeStart"
                                          StrokeMove="PenPreview_StrokeMove"
                                          StrokeEnd="PenPreview_StrokeEnd" />
        </Grid>
    </DockPanel>
</UserControl>
