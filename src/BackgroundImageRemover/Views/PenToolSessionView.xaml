<UserControl x:Class="BackgroundImageRemover.Views.PenToolSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource Theme.BarBackground}" Padding="12,8" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Background="#FF0EA5E9" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="✏️ PEN" Foreground="White" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Theme.ForegroundBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="✕ Cancel (Esc)" Command="{Binding CancelCommand}" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource Theme.PanelBackground}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" />
                    <Button Content="✓ Apply (Enter)" Command="{Binding ApplyCommand}" Padding="16,6" Background="#FF0EA5E9" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Theme.BarBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <StatusBarItem><TextBlock Text="{Binding StatusMessage}" /></StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Right" Width="300" Padding="14" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource Theme.PanelBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Pen" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource Theme.ForegroundBrush}" />

                    <TextBlock Text="Drag on the image to draw freehand." Margin="0,0,0,12"
                               Foreground="{DynamicResource Theme.MutedForegroundBrush}" TextWrapping="Wrap" />

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Size" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding PenWidth, StringFormat='{}{0:0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="1" Maximum="100" Value="{Binding PenWidth}" SmallChange="1" Margin="0,2,0,12" />

                    <TextBlock Text="Color" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Rectangle Width="24" Height="24" Fill="{Binding Color, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" />
                        <Button x:Name="ChooseColorButton" Content="Choose color..." Margin="8,0,0,0" Click="ChooseColorButton_Click" />
                        <Popup IsOpen="{Binding IsColorPickerOpen}" PlacementTarget="{Binding ElementName=ChooseColorButton}" StaysOpen="False" AllowsTransparency="True" Placement="Right">
                            <Border Background="{DynamicResource Theme.PopupBackground}" BorderBrush="{DynamicResource Theme.PopupBorderBrush}" BorderThickness="1">
                                <controls:SimpleColorPickerControl SelectedColor="{Binding Color}" />
                            </Border>
                        </Popup>
                    </StackPanel>

                    <Button Content="✕ Clear all strokes" Command="{Binding ClearCommand}" Height="30" Background="{DynamicResource Theme.PanelHeaderBackground}" Foreground="{DynamicResource Theme.ForegroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Margin="8">
            <controls:ImagePreviewControl x:Name="PenPreview"
                                          ImageSource="{Binding ResultBitmap}"
                                          Mode="{x:Static models:InteractionMode.Brush}"
                                          BrushRadius="{Binding PenWidth}"
                                          StrokeStart="PenPreview_StrokeStart"
                                          StrokeMove="PenPreview_StrokeMove"
                                          StrokeEnd="PenPreview_StrokeEnd" />
        </Grid>
    </DockPanel>
</UserControl>
