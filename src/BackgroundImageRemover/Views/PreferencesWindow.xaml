<Window x:Class="BackgroundImageRemover.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}"
        Background="{DynamicResource Theme.WindowBackground}">
    <Border BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Padding="22" CornerRadius="8" Margin="12">
        <StackPanel MinWidth="380">
            <TextBlock Text="Theme" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,8" />

            <RadioButton Content="Follow Windows" GroupName="Theme" Margin="0,0,0,4"
                         IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=System}" />
            <RadioButton Content="Light" GroupName="Theme" Margin="0,0,0,4"
                         IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Light}" />
            <RadioButton Content="Dark" GroupName="Theme" Margin="0,0,0,16"
                         IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Dark}" />

            <TextBlock Text="Language" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,8" />

            <ComboBox SelectedIndex="{Binding LanguageIndex}" Margin="0,0,0,16" Padding="4">
                <ComboBoxItem Content="System" />
                <ComboBoxItem Content="English" />
                <ComboBoxItem Content="Italiano" />
            </ComboBox>

            <TextBlock Text="Startup" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,8" />

            <CheckBox Content="Reopen the last opened files on startup" IsChecked="{Binding ReopenLastSession}" Margin="0,0,0,12" />

            <TextBlock Text="Autosave" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundBrush}" Margin="0,0,0,8" />

            <CheckBox Content="Save a recovery snapshot of dirty documents periodically" IsChecked="{Binding EnableAutosave}" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="24,0,0,20">
                <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="64" Padding="2"
                          ItemsSource="{Binding AutosaveIntervals}"
                          SelectedItem="{Binding AutosaveIntervalMinutes}" />
                <TextBlock Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0" Cursor="Hand" />
                <Button Content="OK" IsDefault="True" Click="Ok_Click" Padding="20,6" Background="{DynamicResource Theme.AccentBackground}" Foreground="{DynamicResource Theme.AccentForeground}" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
