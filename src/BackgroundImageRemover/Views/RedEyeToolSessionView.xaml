<UserControl x:Class="BackgroundImageRemover.Views.RedEyeToolSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
        <controls:ToolSessionHeader Badge="👁 RED EYE" Accent="#FFDC2626" />

<controls:ToolSessionPanel Title="Red Eye Removal" >
        <controls:ToolSessionPanel.Panel>
<StackPanel>

                    <controls:SliderField Header="Brush radius" Value="{Binding Radius}" Minimum="5" Maximum="80" ValueFormat="{}{0:0}px"  />
<TextBlock Text="Click on a red eye to remove it." Foreground="{DynamicResource Theme.MutedForegroundBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />

</StackPanel>
</controls:ToolSessionPanel.Panel>

        <controls:ToolSessionPanel.Preview>


        <Grid Margin="8">
            <Border BorderBrush="#FF3A3A3A" BorderThickness="1">
                <controls:ImagePreviewControl x:Name="RedEyePreview"
                                               ImageSource="{Binding ResultBitmap}"
                                               Mode="{Binding Source={x:Static models:InteractionMode.Brush}}"
                                               BrushRadius="{Binding Radius}"
                                               StrokeStart="RedEyePreview_StrokeStart" />
            </Border>
        </Grid>
    
        </controls:ToolSessionPanel.Preview>
    </controls:ToolSessionPanel>
</DockPanel>
</UserControl>
