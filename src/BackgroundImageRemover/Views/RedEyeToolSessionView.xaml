<UserControl x:Class="BackgroundImageRemover.Views.RedEyeToolSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
        <controls:ToolSessionHeader Badge="👁 RED EYE" Accent="#FFDC2626" />

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Theme.BarBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <StatusBarItem><TextBlock Text="{Binding StatusMessage}" /></StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Right" Width="300" Padding="14" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource Theme.PanelBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Red Eye Removal" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource Theme.ForegroundBrush}" />

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Brush radius" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding Radius, StringFormat='{}{0:0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="5" Maximum="80" Value="{Binding Radius}" Margin="0,2,0,8" />

                    <TextBlock Text="Click on a red eye to remove it." Foreground="{DynamicResource Theme.MutedForegroundBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <Button Content="↺ Reset" Command="{Binding ResetCommand}" Height="30" Background="{DynamicResource Theme.PanelHeaderBackground}" Foreground="{DynamicResource Theme.ForegroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Margin="8">
            <Border BorderBrush="#FF3A3A3A" BorderThickness="1">
                <controls:ImagePreviewControl x:Name="RedEyePreview"
                                               ImageSource="{Binding ResultBitmap}"
                                               Mode="{Binding Source={x:Static models:InteractionMode.Brush}}"
                                               BrushRadius="{Binding Radius}"
                                               StrokeStart="RedEyePreview_StrokeStart"
                                               StrokeMove="RedEyePreview_StrokeMove"
                                               StrokeEnd="RedEyePreview_StrokeEnd" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
