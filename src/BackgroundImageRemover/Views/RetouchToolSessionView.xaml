<UserControl x:Class="BackgroundImageRemover.Views.RetouchToolSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
        </Style>
    </UserControl.Resources>
    <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
        <controls:ToolSessionHeader Badge="🖌 RETOUCH &amp; BRUSH" Accent="#FF8E24AA" />

        <!-- Status bar -->
<!-- Side Controls Panel -->
        <controls:ToolSessionPanel Title="Retouch Tools" PanelWidth="280"  ShowReset="False">
        <controls:ToolSessionPanel.Panel>

                    <TextBlock Text="Tool Selection:" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <RadioButton Content="Brush" GroupName="RetouchModeTab" Margin="0,0,4,0"
                                     IsChecked="{Binding ResultMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Brush}" />
                        <RadioButton Content="Magic Wand" GroupName="RetouchModeTab" Margin="4,0,0,0"
                                     IsChecked="{Binding ResultMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=MagicWand}" />
                    </UniformGrid>

                    <TextBlock Text="Action:" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <RadioButton Content="Erase" GroupName="BrushModeTab" Margin="0,0,4,0"
                                     IsChecked="{Binding BrushMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Erase}" />
                        <RadioButton Content="Restore" GroupName="BrushModeTab" Margin="4,0,0,0"
                                     IsChecked="{Binding BrushMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Restore}" />
                    </UniformGrid>

                    <StackPanel Visibility="{Binding ResultMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Brush}">
                        <controls:SliderField Header="Brush Size:" Value="{Binding BrushRadius}" Minimum="2" Maximum="150" ValueFormat="{}{0:0} px"  />
<controls:SliderField Header="Hardness:" Value="{Binding BrushHardness}" Minimum="0" Maximum="0.95" ValueFormat="{}{0:P0}"  />
<controls:SliderField Header="Opacity:" Value="{Binding BrushOpacity}" Minimum="0.05" Maximum="1" ValueFormat="{}{0:P0}"  />
</StackPanel>

                    <StackPanel Visibility="{Binding ResultMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=MagicWand}">
                        <controls:SliderField Header="Tolerance:" Value="{Binding MagicWandTolerance}" Minimum="1" Maximum="100" ValueFormat="{}{0:0}"  />
</StackPanel>

                    <Separator Margin="0,8,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="↶ Undo" Command="{Binding UndoCommand}" Padding="10,4" Margin="0,0,6,0" />
                        <Button Content="↷ Redo" Command="{Binding RedoCommand}" Padding="10,4" />
                    </StackPanel>

                    <Separator Margin="0,12,0,12" />
                    <TextBlock Text="Edge Refinement" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Button Content="Smooth edges" Command="{Binding SmoothEdgesCommand}" Margin="0,0,0,6" />
                    <Button Content="Feather edges" Command="{Binding FeatherEdgesCommand}" Margin="0,0,0,6" />
                    <Button Content="Remove specks" Command="{Binding RemoveSpecksCommand}" Margin="0,0,0,6" />
                    <Button Content="Invert mask" Command="{Binding InvertMaskCommand}" />

                    <Separator Margin="0,12,0,12" />
                    <TextBlock Text="Whole-image effects" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <controls:SliderField Header="Dehaze" Value="{Binding Dehaze}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" ValueFormat="{}{0:P0}"  />
<controls:SliderField Header="Blur background" Value="{Binding BlurBackgroundRadius}" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueFormat="{}{0}px"  />
<controls:SliderField Header="Sharpen subject" Value="{Binding SharpenStrength}" Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.2" ValueFormat="{}{0:0.00}"  />
<controls:SliderField Header="Color boost" Value="{Binding ColorBoost}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" ValueFormat="{}{0:P0}"  />
<CheckBox Content="Defringe edges" IsChecked="{Binding Defringe}" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <Separator Margin="0,8,0,12" />
                    <TextBlock Text="Repair" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <controls:SliderField Header="Dust removal" Value="{Binding RemoveDustKernel}" Minimum="0" Maximum="15" TickFrequency="2" IsSnapToTickEnabled="True"  />
<controls:SliderField Header="Surface blur" Value="{Binding SurfaceBlur}" Minimum="0" Maximum="1" SmallChange="0.05" ValueFormat="{}{0:P0}"  />
<controls:SliderField Header="Chromatic aberration" Value="{Binding ChromaticAberration}" Minimum="0" Maximum="2" SmallChange="0.05" ValueFormat="{}{0:0.00}"  />
<CheckBox Content="Auto contrast" IsChecked="{Binding AutoContrast}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <CheckBox Content="Auto white balance" IsChecked="{Binding AutoWhiteBalance}" FontWeight="SemiBold" />
                </controls:ToolSessionPanel.Panel>

        <controls:ToolSessionPanel.Preview>


        <!-- Canvas -->
        <Grid Margin="8">
            <controls:ImagePreviewControl x:Name="ResultEditPreview"
                                           ImageSource="{Binding ResultBitmap}"
                                           Mode="{Binding ResultMode}"
                                           BrushRadius="{Binding BrushRadius}"
                                           StrokeStart="ResultEditPreview_StrokeStart"
                                           StrokeMove="ResultEditPreview_StrokeMove"
                                           StrokeEnd="ResultEditPreview_StrokeEnd"
                                           WandClicked="ResultEditPreview_WandClicked" />
        </Grid>
    
        </controls:ToolSessionPanel.Preview>
    </controls:ToolSessionPanel>
</DockPanel>
</UserControl>
