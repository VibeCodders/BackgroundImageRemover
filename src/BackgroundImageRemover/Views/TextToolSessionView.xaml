<UserControl x:Class="BackgroundImageRemover.Views.TextToolSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             xmlns:models="clr-namespace:BackgroundImageRemover.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="TextAnchorValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TextAnchor" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
        </Style>
    </UserControl.Resources>

    <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource Theme.BarBackground}" Padding="12,8" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Background="#FFDB2777" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="✎ TEXT" Foreground="White" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Theme.ForegroundBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="✕ Cancel (Esc)" Command="{Binding CancelCommand}" Padding="12,6" Margin="0,0,8,0" Background="{DynamicResource Theme.PanelBackground}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" />
                    <Button Content="✓ Apply (Enter)" Command="{Binding ApplyCommand}" Padding="16,6" Background="#FFDB2777" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Theme.BarBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <StatusBarItem><TextBlock Text="{Binding StatusMessage}" /></StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Right" Width="300" Padding="14" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource Theme.PanelBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Text Watermark" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource Theme.ForegroundBrush}" />

                    <TextBlock Text="Text" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Size" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding FontSize, StringFormat='{}{0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="8" Maximum="200" Value="{Binding FontSize}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,12" />

                    <TextBlock Text="Position" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Source={StaticResource TextAnchorValues}}" SelectedItem="{Binding Anchor}" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Rectangle Width="24" Height="24" Fill="{Binding Color, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" />
                        <Button x:Name="ChooseColorButton" Content="Choose color..." Margin="8,0,0,0" Click="ChooseColorButton_Click" />
                        <Popup IsOpen="{Binding IsColorPickerOpen}" PlacementTarget="{Binding ElementName=ChooseColorButton}" StaysOpen="False" AllowsTransparency="True" Placement="Right">
                            <Border Background="{DynamicResource Theme.PopupBackground}" BorderBrush="{DynamicResource Theme.PopupBorderBrush}" BorderThickness="1">
                                <controls:SimpleColorPickerControl SelectedColor="{Binding Color}" />
                            </Border>
                        </Popup>
                    </StackPanel>

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Opacity" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding Opacity, StringFormat='{}{0:P0}'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Opacity}" SmallChange="0.05" LargeChange="0.1" Margin="0,2,0,12" />

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Margin" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding Margin, StringFormat='{}{0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="200" Value="{Binding Margin}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,8" />

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Letter spacing" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding LetterSpacing, StringFormat='{}{0:0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="30" Value="{Binding LetterSpacing}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,8" />

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Line spacing" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding LineSpacing, StringFormat='{}{0}px'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="100" Value="{Binding LineSpacing}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,8" />

                    <CheckBox Content="Auto-fit to image width" IsChecked="{Binding AutoFitWidth}" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Rotation" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding Rotation, StringFormat='{}{0:0}°'}" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="-180" Maximum="180" Value="{Binding Rotation}" Margin="0,2,0,12" />

                    <CheckBox Content="Bold" IsChecked="{Binding Bold}" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <TextBlock Text="Outline" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Thickness" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding OutlineThickness, StringFormat='{}{0}px'}" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="10" Value="{Binding OutlineThickness}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Rectangle Width="24" Height="24" Fill="{Binding OutlineColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" />
                        <Button x:Name="ChooseOutlineColorButton" Content="Outline color..." Margin="8,0,0,0" Click="ChooseOutlineColorButton_Click" />
                        <Popup IsOpen="{Binding IsOutlineColorPickerOpen}" PlacementTarget="{Binding ElementName=ChooseOutlineColorButton}" StaysOpen="False" AllowsTransparency="True" Placement="Right">
                            <Border Background="{DynamicResource Theme.PopupBackground}" BorderBrush="{DynamicResource Theme.PopupBorderBrush}" BorderThickness="1">
                                <controls:SimpleColorPickerControl SelectedColor="{Binding OutlineColor}" />
                            </Border>
                        </Popup>
                    </StackPanel>

                    <TextBlock Text="Shadow" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <DockPanel>
                        <TextBlock Text="Offset" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding ShadowOffset, StringFormat='{}{0}px'}" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="20" Value="{Binding ShadowOffset}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8" />
                    <DockPanel>
                        <TextBlock Text="Blur" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding ShadowBlur, StringFormat='{}{0:0}px'}" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="20" Value="{Binding ShadowBlur}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8" />
                    <DockPanel>
                        <TextBlock Text="Opacity" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding ShadowOpacity, StringFormat='{}{0:P0}'}" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="1" Value="{Binding ShadowOpacity}" TickFrequency="0.05" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Rectangle Width="24" Height="24" Fill="{Binding ShadowColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" />
                        <Button x:Name="ChooseShadowColorButton" Content="Shadow color..." Margin="8,0,0,0" Click="ChooseShadowColorButton_Click" />
                        <Popup IsOpen="{Binding IsShadowColorPickerOpen}" PlacementTarget="{Binding ElementName=ChooseShadowColorButton}" StaysOpen="False" AllowsTransparency="True" Placement="Right">
                            <Border Background="{DynamicResource Theme.PopupBackground}" BorderBrush="{DynamicResource Theme.PopupBorderBrush}" BorderThickness="1">
                                <controls:SimpleColorPickerControl SelectedColor="{Binding ShadowColor}" />
                            </Border>
                        </Popup>
                    </StackPanel>

                    <CheckBox Content="Background plate" IsChecked="{Binding BackgroundPlate}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Visibility="{Binding BackgroundPlate, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Rectangle Width="24" Height="24" Fill="{Binding PlateColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="Gray" />
                            <Button x:Name="ChoosePlateColorButton" Content="Plate color..." Margin="8,0,0,0" Click="ChoosePlateColorButton_Click" />
                            <Popup IsOpen="{Binding IsPlateColorPickerOpen}" PlacementTarget="{Binding ElementName=ChoosePlateColorButton}" StaysOpen="False" AllowsTransparency="True" Placement="Right">
                                <Border Background="{DynamicResource Theme.PopupBackground}" BorderBrush="{DynamicResource Theme.PopupBorderBrush}" BorderThickness="1">
                                    <controls:SimpleColorPickerControl SelectedColor="{Binding PlateColor}" />
                                </Border>
                            </Popup>
                        </StackPanel>
                        <DockPanel>
                            <TextBlock Text="Opacity" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding PlateOpacity, StringFormat='{}{0:P0}'}" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="1" Value="{Binding PlateOpacity}" TickFrequency="0.05" Margin="0,0,0,8" />
                        <DockPanel>
                            <TextBlock Text="Padding" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding PlatePadding, StringFormat='{}{0}px'}" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="60" Value="{Binding PlatePadding}" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </StackPanel>

                    <Button Content="✕ Clear text" Command="{Binding ClearTextCommand}" Height="30" Background="{DynamicResource Theme.PanelHeaderBackground}" Foreground="{DynamicResource Theme.ForegroundBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Margin="8">
            <Border BorderBrush="#FF3A3A3A" BorderThickness="1">
                <Image Source="{Binding ResultBitmap}" Stretch="Uniform" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
