<UserControl x:Class="BackgroundImageRemover.Views.UncropToolSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1200">
    <UserControl.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ForegroundBrush}" />
        </Style>
    </UserControl.Resources>
    <DockPanel TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
        <controls:ToolSessionHeader DockPanel.Dock="Top" Badge="⤢ UNCROP / EXPAND" Accent="#FF0078D7" />

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Theme.BarBackground}" TextElement.Foreground="{DynamicResource Theme.ForegroundBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Button Content="Cancel" Command="{Binding CancelFillCommand}" Padding="6,1" FontSize="11" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Sidebar controls -->
        <Border DockPanel.Dock="Left" Width="300" Margin="12" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="0,0,1,0" Padding="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Aspect ratio" FontWeight="Bold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Options.AspectPresets}" DisplayMemberPath="Label"
                              SelectedItem="{Binding Options.SelectedPreset}" Margin="0,0,0,12" />

                    <TextBlock Text="Target size" FontWeight="Bold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Options.SizePresets}" DisplayMemberPath="Label"
                              SelectedItem="{Binding Options.SelectedSizePreset}" Margin="0,0,0,12" />

                    <TextBlock Text="Padding (px)" FontWeight="Bold" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Left" VerticalAlignment="Center" Margin="0,0,4,4" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,4" Text="{Binding Options.PaddingLeftPx, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Top" VerticalAlignment="Center" Margin="0,0,4,4" />
                        <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,4" Text="{Binding Options.PaddingTopPx, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" Text="{Binding Options.PaddingRightPx, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Bottom" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Options.PaddingBottomPx, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Text="Fill mode" FontWeight="Bold" Margin="0,0,0,4" />
                    
                    <!-- Mirror Mode -->
                    <RadioButton Content="Mirror" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Mirror}" />
                    <StackPanel Margin="16,0,0,8" Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Mirror}">
                        <TextBlock Text="Mirror reflection type:" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="Reflect 101" GroupName="UncropMirrorType" Margin="0,0,8,0"
                                         IsChecked="{Binding Options.SelectedMirrorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Reflect101}" />
                            <RadioButton Content="Reflect" GroupName="UncropMirrorType"
                                         IsChecked="{Binding Options.SelectedMirrorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Reflect}" />
                        </StackPanel>

                        <controls:SliderField Header="Blur radius:" Value="{Binding Options.MirrorBlurRadius}" Minimum="0" Maximum="50" SmallChange="2" LargeChange="10" ValueFormat="{}{0} px"  />


                        <controls:SliderField Header="Fade opacity:" Value="{Binding Options.MirrorFadeOpacity}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.2" ValueFormat="{}{0:P0}"  />

                    </StackPanel>

                    <!-- Inpaint Mode -->
                    <RadioButton Content="Content-aware inpaint" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Inpaint}" />
                    <StackPanel Margin="16,0,0,8" Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Inpaint}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="Telea" GroupName="UncropInpaintMethod" Margin="0,0,8,0"
                                         IsChecked="{Binding Options.SelectedInpaintMethod, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Telea}" />
                            <RadioButton Content="Navier-Stokes" GroupName="UncropInpaintMethod"
                                         IsChecked="{Binding Options.SelectedInpaintMethod, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NavierStokes}" />
                        </StackPanel>
                        
                        <controls:SliderField Header="Radius:" Value="{Binding Options.InpaintRadius}" Minimum="1" Maximum="50" ValueFormat="{}{0:F0} px"  />


                        <controls:SliderField Header="Blend margin:" Value="{Binding Options.BlendMargin}" Minimum="0" Maximum="30" ValueFormat="{}{0} px"  />


                        <CheckBox Content="Pre-fill edge colors" Margin="0,2,0,4" IsChecked="{Binding Options.InpaintPreFillEdgeAverage}" />
                    </StackPanel>

                    <!-- Solid Color Mode -->
                    <RadioButton Content="Solid color" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SolidColor}" />
                    <StackPanel Margin="16,0,0,8" Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=SolidColor}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="Edge average" GroupName="UncropColorSource" Margin="0,0,8,0"
                                         IsChecked="{Binding Options.SelectedColorSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=EdgeAverage}" />
                            <RadioButton Content="Custom color" GroupName="UncropColorSource"
                                         IsChecked="{Binding Options.SelectedColorSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CustomColor}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                    Visibility="{Binding Options.SelectedColorSource, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=CustomColor}">
                            <Button x:Name="UncropColorPickerButton" Padding="4,2" Click="UncropColorPickerButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Style="{StaticResource ColorSwatch}" Fill="{Binding Options.CustomSolidColor, Converter={StaticResource ColorToBrushConverter}}" />
                                    <TextBlock Text="Choose color..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Popup IsOpen="{Binding Options.IsColorPickerOpen}" PlacementTarget="{Binding ElementName=UncropColorPickerButton}"
                                   StaysOpen="False" AllowsTransparency="True">
                                <Border Background="{DynamicResource Theme.PopupBackground}" BorderBrush="{DynamicResource Theme.PopupBorderBrush}" BorderThickness="1" Padding="8" CornerRadius="4">
                                    <controls:SimpleColorPickerControl SelectedColor="{Binding Options.CustomSolidColor, Mode=TwoWay}" />
                                </Border>
                            </Popup>
                        </StackPanel>

                        <CheckBox Content="Blurred gradient fill" Margin="0,0,0,4" IsChecked="{Binding Options.BlurredColorFill}" />
                        <DockPanel Margin="0,0,0,4" Visibility="{Binding Options.BlurredColorFill, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Blur radius:" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" Width="70" />
                            <Slider Minimum="0" Maximum="101" Value="{Binding Options.BlurRadius}" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Zoom Blur Mode -->
                    <RadioButton Content="Zoom &amp; Blur background" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ZoomBlur}" />
                    <StackPanel Margin="16,0,0,8" Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ZoomBlur}">
                        <controls:SliderField Header="Blur radius:" Value="{Binding Options.ZoomBlurRadius}" Minimum="1" Maximum="101" SmallChange="2" LargeChange="10" ValueFormat="{}{0} px"  />

                        <controls:SliderField Header="Zoom scale:" Value="{Binding Options.ZoomScale}" Minimum="1.0" Maximum="2.5" SmallChange="0.05" LargeChange="0.25" ValueFormat="{}{0:F2}x"  />

                        <controls:SliderField Header="Blend margin:" Value="{Binding Options.BlendMargin}" Minimum="0" Maximum="30" SmallChange="1" LargeChange="5" ValueFormat="{}{0} px"  />

                    </StackPanel>

                    <!-- Edge Gradient Mode -->
                    <RadioButton Content="Edge gradient" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=EdgeGradient}" />
                    <StackPanel Margin="16,0,0,8" Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=EdgeGradient}">
                        <TextBlock Text="Gradient style:" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding Options.GradientModes}" SelectedItem="{Binding Options.SelectedGradientMode}" Margin="0,0,0,6" />

                        <controls:SliderField Header="Noise (dither):" Value="{Binding Options.GradientNoiseAmount}" Minimum="0.0" Maximum="0.20" SmallChange="0.01" LargeChange="0.05" ValueFormat="{}{0:P0}"  />

                    </StackPanel>

                    <!-- Patch Synthesis Mode -->
                    <RadioButton Content="Patch texture synthesis" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PatchSynthesis}" />
                    <StackPanel Margin="16,0,0,8" Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=PatchSynthesis}">
                        <controls:SliderField Header="Patch size:" Value="{Binding Options.PatchSize}" Minimum="8" Maximum="64" SmallChange="4" LargeChange="8" ValueFormat="{}{0} px"  />

                        <controls:SliderField Header="Blend overlap:" Value="{Binding Options.PatchBlendOverlap}" Minimum="2" Maximum="24" SmallChange="2" LargeChange="4" ValueFormat="{}{0} px"  />

                    </StackPanel>

                    <!-- Replicate Mode -->
                    <RadioButton Content="Edge stretch (Replicate)" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Replicate}" />
                    <StackPanel Margin="16,0,0,8" Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Replicate}">
                        <controls:SliderField Header="Smoothing:" Value="{Binding Options.ReplicateSmoothRadius}" Minimum="0" Maximum="30" SmallChange="2" LargeChange="6" ValueFormat="{}{0} px"  />

                    </StackPanel>

                    <!-- Wrap Mode -->
                    <RadioButton Content="Tile / Pattern (Wrap)" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Wrap}" />

                    <!-- AI Outpaint Mode -->
                    <RadioButton Content="AI outpainting (LaMa)" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 ToolTip="AI outpainting with LaMa — the model is downloaded on first use (pick a variant below)."
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AiOutpaint}" />
                    <StackPanel Margin="16,0,0,8"
                                Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=AiOutpaint}">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Model:" FontSize="11" Foreground="{DynamicResource Theme.MutedForegroundBrush}"
                                       DockPanel.Dock="Left" VerticalAlignment="Center" Width="45" />
                            <ComboBox ItemsSource="{Binding Options.AiModels}"
                                      SelectedItem="{Binding Options.SelectedAiModel}"
                                      DisplayMemberPath="DisplayName" FontSize="11" Height="24"
                                      ToolTip="LaMa checkpoint — smaller models download and load faster but can be less accurate." />
                        </DockPanel>
                        <CheckBox Content="GPU (DirectML)" FontSize="11" IsChecked="{Binding Options.UseGpu}"
                                  IsEnabled="{Binding Options.IsGpuSupported}"
                                  ToolTip="Run LaMa on the GPU via DirectML. Requires a DirectX 12 GPU and a build compiled with -p:UseDirectML=true; falls back to CPU automatically." />
                    </StackPanel>

                    <Separator Margin="0,8,0,8" />
                    <TextBlock Text="Finishing" FontWeight="Bold" Margin="0,0,0,4" />

                    <controls:SliderField Header="Corner radius:" Value="{Binding Options.CornerRadius}" Minimum="0" Maximum="400" ValueFormat="{}{0} px"  />


                    <controls:SliderField Header="Border:" Value="{Binding Options.BorderThickness}" Minimum="0" Maximum="200" ValueFormat="{}{0} px"  />


                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="UncropBorderColorButton" Padding="4,2" Click="UncropBorderColorButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource ColorSwatch}" Fill="{Binding Options.BorderColor, Converter={StaticResource ColorToBrushConverter}}" />
                                <TextBlock Text="Border color..." VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Popup IsOpen="{Binding Options.IsBorderColorPickerOpen}" PlacementTarget="{Binding ElementName=UncropBorderColorButton}"
                               StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{DynamicResource Theme.PopupBackground}" BorderBrush="{DynamicResource Theme.PopupBorderBrush}" BorderThickness="1" Padding="8" CornerRadius="4">
                                <controls:SimpleColorPickerControl SelectedColor="{Binding Options.BorderColor, Mode=TwoWay}" />
                            </Border>
                        </Popup>
                    </StackPanel>

                    <controls:SliderField Header="Grain:" Value="{Binding Options.GrainAmount}" Minimum="0" Maximum="1" ValueFormat="{}{0:P0}"  />


                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox Content="Flip H" IsChecked="{Binding Options.FlipHorizontal}" Margin="0,0,8,0" />
                        <CheckBox Content="Flip V" IsChecked="{Binding Options.FlipVertical}" />
                    </StackPanel>

                    <controls:SliderField Header="Rotate:" Value="{Binding Options.RotateAngle}" Minimum="-180" Maximum="180" ValueFormat="{}{0:F0}°"  />


                    <controls:SliderField Header="Vignette:" Value="{Binding Options.Vignette}" Minimum="0" Maximum="1" ValueFormat="{}{0:P0}"  />


                    <controls:SliderField Header="Saturation:" Value="{Binding Options.Saturation}" Minimum="0" Maximum="3" ValueFormat="{}{0:F2}x"  />


                    <controls:SliderField Header="Contrast:" Value="{Binding Options.Contrast}" Minimum="0.1" Maximum="3" ValueFormat="{}{0:F2}x"  />


                    <controls:SliderField Header="Brightness:" Value="{Binding Options.Brightness}" Minimum="-100" Maximum="100" ValueFormat="{}{0:F0}"  />


                    <controls:SliderField Header="Sharpen:" Value="{Binding Options.SharpenStrength}" Minimum="0" Maximum="3" ValueFormat="{}{0:F2}"  />


                    <controls:SliderField Header="Blur:" Value="{Binding Options.FinishBlurRadius}" Minimum="0" Maximum="50" ValueFormat="{}{0} px"  />


                    <controls:SliderField Header="Temperature:" Value="{Binding Options.Temperature}" Minimum="-100" Maximum="100" ValueFormat="{}{0:F0}"  />


                    <controls:SliderField Header="Tint:" Value="{Binding Options.Tint}" Minimum="-100" Maximum="100" ValueFormat="{}{0:F0}"  />


                    <controls:SliderField Header="Denoise:" Value="{Binding Options.Denoise}" Minimum="0" Maximum="1" ValueFormat="{}{0:P0}"  />


                    <Button Content="Preview fill" Command="{Binding ApplyFillCommand}" Margin="0,14,0,0" Padding="8" FontWeight="Bold" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Canvas Panes -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Canvas Expansion (Drag handles or set padding)" FontWeight="Bold" Margin="0,0,0,4" />
                <controls:UncropCanvasControl ImageSource="{Binding SourceBitmap}" ImagePadding="{Binding Options.Padding, Mode=TwoWay}" />
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Result Preview" FontWeight="Bold" Margin="0,0,0,4" />
                <Border Style="{StaticResource PreviewBorder}">
                    <controls:ZoomableImageControl ImageSource="{Binding PreviewResult}" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
