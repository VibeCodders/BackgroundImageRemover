<UserControl x:Class="BackgroundImageRemover.Views.UncropView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1200"
             AllowDrop="True" Drop="UncropView_Drop" DragOver="UncropView_DragOver">
    <DockPanel>
        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Open image..." Command="{Binding OpenImageCommand}" Padding="8,2" />
            <Separator />
            <Button Content="Undo" Command="{Binding UndoCommand}" Padding="8,2" />
            <Button Content="Redo" Command="{Binding RedoCommand}" Padding="8,2" />
            <Separator />
            <Button Content="Export PNG..." Command="{Binding SaveAsCommand}" Padding="8,2" />
        </ToolBar>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Button Content="Cancel" Command="{Binding CancelFillCommand}" Padding="6,1" FontSize="11" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Sidebar controls -->
        <Border DockPanel.Dock="Left" Width="290" Margin="12" BorderBrush="#FFCCCCCC" BorderThickness="0,0,1,0" Padding="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsImageLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Aspect ratio" FontWeight="Bold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Options.AspectPresets}" DisplayMemberPath="Label"
                              SelectedItem="{Binding Options.SelectedPreset}" Margin="0,0,0,12" />

                    <TextBlock Text="Padding (px)" FontWeight="Bold" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Left" VerticalAlignment="Center" Margin="0,0,4,4" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,4" Text="{Binding Options.PaddingLeftPx, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Top" VerticalAlignment="Center" Margin="0,0,4,4" />
                        <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,4" Text="{Binding Options.PaddingTopPx, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" Text="{Binding Options.PaddingRightPx, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Bottom" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Options.PaddingBottomPx, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Text="Fill mode" FontWeight="Bold" Margin="0,0,0,4" />
                    
                    <!-- Mirror Mode -->
                    <RadioButton Content="Mirror" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Mirror}" />
                    <StackPanel Margin="16,0,0,8" Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Mirror}">
                        <TextBlock Text="Mirror reflection type:" FontSize="11" Foreground="#FF666666" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="Reflect 101" GroupName="UncropMirrorType" Margin="0,0,8,0"
                                         IsChecked="{Binding Options.SelectedMirrorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Reflect101}" />
                            <RadioButton Content="Reflect" GroupName="UncropMirrorType"
                                         IsChecked="{Binding Options.SelectedMirrorType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Reflect}" />
                        </StackPanel>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Blur radius:" FontSize="11" Foreground="#FF666666" DockPanel.Dock="Left" VerticalAlignment="Center" Width="70" />
                            <TextBlock Text="{Binding Options.MirrorBlurRadius, StringFormat={}{0} px}" FontSize="11" DockPanel.Dock="Right" Width="40" TextAlignment="Right" />
                            <Slider Minimum="0" Maximum="50" Value="{Binding Options.MirrorBlurRadius}" SmallChange="2" LargeChange="10" TickFrequency="2" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                        </DockPanel>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Fade opacity:" FontSize="11" Foreground="#FF666666" DockPanel.Dock="Left" VerticalAlignment="Center" Width="70" />
                            <TextBlock Text="{Binding Options.MirrorFadeOpacity, StringFormat={}{0:P0}}" FontSize="11" DockPanel.Dock="Right" Width="40" TextAlignment="Right" />
                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding Options.MirrorFadeOpacity}" SmallChange="0.05" LargeChange="0.2" TickFrequency="0.05" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Inpaint Mode -->
                    <RadioButton Content="Content-aware inpaint" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Inpaint}" />
                    <StackPanel Margin="16,0,0,8"
                                Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Inpaint}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="Telea" GroupName="UncropInpaintMethod" Margin="0,0,8,0"
                                         IsChecked="{Binding Options.SelectedInpaintMethod, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Telea}" />
                            <RadioButton Content="Navier-Stokes" GroupName="UncropInpaintMethod"
                                         IsChecked="{Binding Options.SelectedInpaintMethod, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NavierStokes}" />
                        </StackPanel>
                        
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Radius:" FontSize="11" Foreground="#FF666666" DockPanel.Dock="Left" VerticalAlignment="Center" Width="70" />
                            <TextBlock Text="{Binding Options.InpaintRadius, StringFormat={}{0:F0} px}" FontSize="11" DockPanel.Dock="Right" Width="40" TextAlignment="Right" />
                            <Slider Minimum="1" Maximum="50" Value="{Binding Options.InpaintRadius}" SmallChange="1" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        </DockPanel>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Blend margin:" FontSize="11" Foreground="#FF666666" DockPanel.Dock="Left" VerticalAlignment="Center" Width="70" />
                            <TextBlock Text="{Binding Options.BlendMargin, StringFormat={}{0} px}" FontSize="11" DockPanel.Dock="Right" Width="40" TextAlignment="Right" />
                            <Slider Minimum="0" Maximum="30" Value="{Binding Options.BlendMargin}" SmallChange="1" LargeChange="5" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        </DockPanel>

                        <CheckBox Content="Pre-fill edge colors" Margin="0,2,0,4"
                                  IsChecked="{Binding Options.InpaintPreFillEdgeAverage}"
                                  ToolTip="Pre-fills border area with average edge color before inpainting for better color consistency." />
                    </StackPanel>

                    <!-- Solid / Gradient Color Mode -->
                    <RadioButton Content="Solid color" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SolidColor}" />
                    <StackPanel Margin="16,0,0,8"
                                Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=SolidColor}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="Edge average" GroupName="UncropColorSource" Margin="0,0,8,0"
                                         IsChecked="{Binding Options.SelectedColorSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=EdgeAverage}" />
                            <RadioButton Content="Custom color" GroupName="UncropColorSource"
                                         IsChecked="{Binding Options.SelectedColorSource, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CustomColor}" />
                        </StackPanel>

                        <!-- Custom color picker trigger -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                    Visibility="{Binding Options.SelectedColorSource, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=CustomColor}">
                            <Button x:Name="UncropColorPickerButton" Padding="4,2" Click="UncropColorPickerButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="18" Height="18" Fill="{Binding Options.CustomSolidColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="#FF888888" Margin="0,0,6,0" />
                                    <TextBlock Text="Choose color..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Popup IsOpen="{Binding Options.IsColorPickerOpen}" PlacementTarget="{Binding ElementName=UncropColorPickerButton}"
                                   StaysOpen="False" AllowsTransparency="True">
                                <Border Background="#FF2D2D30" BorderBrush="#FF3F3F46" BorderThickness="1" Padding="8" CornerRadius="4">
                                    <controls:SimpleColorPickerControl SelectedColor="{Binding Options.CustomSolidColor, Mode=TwoWay}" />
                                </Border>
                            </Popup>
                        </StackPanel>

                        <CheckBox Content="Blurred gradient fill" Margin="0,0,0,4"
                                  IsChecked="{Binding Options.BlurredColorFill}" />

                        <DockPanel Margin="0,0,0,4"
                                   Visibility="{Binding Options.BlurredColorFill, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Blur radius:" FontSize="11" Foreground="#FF666666" DockPanel.Dock="Left" VerticalAlignment="Center" Width="70" />
                            <TextBlock Text="{Binding Options.BlurRadius, StringFormat={}{0} px}" FontSize="11" DockPanel.Dock="Right" Width="40" TextAlignment="Right" />
                            <Slider Minimum="0" Maximum="101" Value="{Binding Options.BlurRadius}" SmallChange="2" LargeChange="10" TickFrequency="2" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Zoom & Blur Background Mode -->
                    <RadioButton Content="Zoom &amp; Blur background" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ZoomBlur}" />
                    <StackPanel Margin="16,0,0,8" Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ZoomBlur}">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Blur radius:" FontSize="11" Foreground="#FF666666" DockPanel.Dock="Left" VerticalAlignment="Center" Width="70" />
                            <TextBlock Text="{Binding Options.ZoomBlurRadius, StringFormat={}{0} px}" FontSize="11" DockPanel.Dock="Right" Width="40" TextAlignment="Right" />
                            <Slider Minimum="1" Maximum="101" Value="{Binding Options.ZoomBlurRadius}" SmallChange="2" LargeChange="10" TickFrequency="2" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Zoom scale:" FontSize="11" Foreground="#FF666666" DockPanel.Dock="Left" VerticalAlignment="Center" Width="70" />
                            <TextBlock Text="{Binding Options.ZoomScale, StringFormat={}{0:F2}x}" FontSize="11" DockPanel.Dock="Right" Width="40" TextAlignment="Right" />
                            <Slider Minimum="1.0" Maximum="2.5" Value="{Binding Options.ZoomScale}" SmallChange="0.05" LargeChange="0.25" TickFrequency="0.05" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Blend margin:" FontSize="11" Foreground="#FF666666" DockPanel.Dock="Left" VerticalAlignment="Center" Width="70" />
                            <TextBlock Text="{Binding Options.BlendMargin, StringFormat={}{0} px}" FontSize="11" DockPanel.Dock="Right" Width="40" TextAlignment="Right" />
                            <Slider Minimum="0" Maximum="30" Value="{Binding Options.BlendMargin}" SmallChange="1" LargeChange="5" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Edge Gradient Mode -->
                    <RadioButton Content="Edge gradient" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=EdgeGradient}" />
                    <StackPanel Margin="16,0,0,8" Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=EdgeGradient}">
                        <TextBlock Text="Gradient style:" FontSize="11" Foreground="#FF666666" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding Options.GradientModes}" SelectedItem="{Binding Options.SelectedGradientMode}" Margin="0,0,0,6" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Noise (dither):" FontSize="11" Foreground="#FF666666" DockPanel.Dock="Left" VerticalAlignment="Center" Width="70" />
                            <TextBlock Text="{Binding Options.GradientNoiseAmount, StringFormat={}{0:P0}}" FontSize="11" DockPanel.Dock="Right" Width="40" TextAlignment="Right" />
                            <Slider Minimum="0.0" Maximum="0.20" Value="{Binding Options.GradientNoiseAmount}" SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Patch Synthesis Mode -->
                    <RadioButton Content="Patch texture synthesis" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PatchSynthesis}" />
                    <StackPanel Margin="16,0,0,8" Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=PatchSynthesis}">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Patch size:" FontSize="11" Foreground="#FF666666" DockPanel.Dock="Left" VerticalAlignment="Center" Width="70" />
                            <TextBlock Text="{Binding Options.PatchSize, StringFormat={}{0} px}" FontSize="11" DockPanel.Dock="Right" Width="40" TextAlignment="Right" />
                            <Slider Minimum="8" Maximum="64" Value="{Binding Options.PatchSize}" SmallChange="4" LargeChange="8" TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Blend overlap:" FontSize="11" Foreground="#FF666666" DockPanel.Dock="Left" VerticalAlignment="Center" Width="70" />
                            <TextBlock Text="{Binding Options.PatchBlendOverlap, StringFormat={}{0} px}" FontSize="11" DockPanel.Dock="Right" Width="40" TextAlignment="Right" />
                            <Slider Minimum="2" Maximum="24" Value="{Binding Options.PatchBlendOverlap}" SmallChange="2" LargeChange="4" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Replicate / Clamp Mode -->
                    <RadioButton Content="Edge stretch (Replicate)" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Replicate}" />
                    <StackPanel Margin="16,0,0,8" Visibility="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Replicate}">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Smoothing:" FontSize="11" Foreground="#FF666666" DockPanel.Dock="Left" VerticalAlignment="Center" Width="70" />
                            <TextBlock Text="{Binding Options.ReplicateSmoothRadius, StringFormat={}{0} px}" FontSize="11" DockPanel.Dock="Right" Width="40" TextAlignment="Right" />
                            <Slider Minimum="0" Maximum="30" Value="{Binding Options.ReplicateSmoothRadius}" SmallChange="2" LargeChange="6" TickFrequency="2" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Wrap / Tile Mode -->
                    <RadioButton Content="Tile / Pattern (Wrap)" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Wrap}" />

                    <!-- AI Outpaint Mode -->
                    <RadioButton Content="AI outpainting (coming soon)" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsEnabled="False"
                                 ToolTip="Not available yet: no AI outpainting model is configured in this build."
                                 IsChecked="{Binding Options.SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AiOutpaint}" />

                    <Button Content="Apply fill" Command="{Binding ApplyFillCommand}" Margin="0,14,0,0" Padding="8" FontWeight="Bold" />
                    <Button Content="Cancel fill" Command="{Binding CancelFillCommand}" Margin="0,6,0,0" Padding="6"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Canvas Panes -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Canvas (drag the handles, or use the padding controls)" FontWeight="Bold" Margin="0,0,0,4" />
                <controls:UncropCanvasControl ImageSource="{Binding SourceBitmap}" ImagePadding="{Binding Options.Padding, Mode=TwoWay}" />
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Result" FontWeight="Bold" Margin="0,0,0,4" />
                <Border BorderBrush="#FF3A3A3A" BorderThickness="1">
                    <Image Source="{Binding PreviewResult}" Stretch="Uniform" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
