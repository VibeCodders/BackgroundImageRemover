<UserControl x:Class="BackgroundImageRemover.Views.UncropView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BackgroundImageRemover.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             AllowDrop="True" Drop="UncropView_Drop" DragOver="UncropView_DragOver">
    <DockPanel>
        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Open image..." Command="{Binding OpenImageCommand}" Padding="8,2" />
            <Separator />
            <Button Content="Undo" Command="{Binding UndoCommand}" Padding="8,2" />
            <Button Content="Redo" Command="{Binding RedoCommand}" Padding="8,2" />
            <Separator />
            <Button Content="Export PNG..." Command="{Binding SaveAsCommand}" Padding="8,2" />
        </ToolBar>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar IsIndeterminate="True" Width="120" Height="12"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Sidebar controls -->
        <Border DockPanel.Dock="Left" Width="280" Margin="12" BorderBrush="#FFCCCCCC" BorderThickness="0,0,1,0" Padding="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsImageLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Aspect ratio" FontWeight="Bold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AspectPresets}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedPreset}" Margin="0,0,0,12" />

                    <TextBlock Text="Padding (px)" FontWeight="Bold" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Left" VerticalAlignment="Center" Margin="0,0,4,4" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,4" Text="{Binding PaddingLeftPx, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Top" VerticalAlignment="Center" Margin="0,0,4,4" />
                        <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,4" Text="{Binding PaddingTopPx, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" Text="{Binding PaddingRightPx, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Bottom" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PaddingBottomPx, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Text="Fill mode" FontWeight="Bold" Margin="0,0,0,4" />
                    <RadioButton Content="Mirror" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Mirror}" />
                    <RadioButton Content="Content-aware inpaint" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Inpaint}" />
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,4"
                                Visibility="{Binding SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Inpaint}">
                        <RadioButton Content="Telea" GroupName="UncropInpaintMethod" Margin="0,0,8,0"
                                     IsChecked="{Binding SelectedInpaintMethod, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Telea}" />
                        <RadioButton Content="Navier-Stokes" GroupName="UncropInpaintMethod"
                                     IsChecked="{Binding SelectedInpaintMethod, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NavierStokes}" />
                    </StackPanel>
                    <RadioButton Content="Solid color" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsChecked="{Binding SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SolidColor}" />
                    <CheckBox Content="Blurred gradient instead of flat color" Margin="16,0,0,4"
                              IsChecked="{Binding BlurredColorFill}"
                              Visibility="{Binding SelectedFillMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=SolidColor}" />
                    <RadioButton Content="AI outpainting (coming soon)" GroupName="UncropFillMode" Margin="0,0,0,4"
                                 IsEnabled="False"
                                 ToolTip="Not available yet: no AI outpainting model is configured in this build."
                                 IsChecked="{Binding SelectedFillMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AiOutpaint}" />

                    <Button Content="Apply fill" Command="{Binding ApplyFillCommand}" Margin="0,12,0,0" Padding="6" FontWeight="Bold" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Canvas Panes -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Canvas (drag the handles, or use the padding controls)" FontWeight="Bold" Margin="0,0,0,4" />
                <controls:UncropCanvasControl ImageSource="{Binding SourceBitmap}" ImagePadding="{Binding Padding, Mode=TwoWay}" />
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Result" FontWeight="Bold" Margin="0,0,0,4" />
                <Border BorderBrush="#FF3A3A3A" BorderThickness="1">
                    <Image Source="{Binding PreviewResult}" Stretch="Uniform" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
